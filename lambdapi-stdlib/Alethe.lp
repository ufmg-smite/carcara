require open Stdlib.HOL;
require open Stdlib.ExtraRules;
require open Stdlib.Bool;
require open Stdlib.Nat;
require open Stdlib.PropExt;

// Stdlib.ExtraRules pulls in Stdlib.Z and Stdlib.Pos, which both declare decimal
// notation and would capture the numeric literals below. Restore ℕ as their type.
builtin "0" ≔ Stdlib.Nat._0;
builtin "1" ≔ Stdlib.Nat._1;
builtin "2" ≔ Stdlib.Nat._2;
builtin "3" ≔ Stdlib.Nat._3;
builtin "4" ≔ Stdlib.Nat._4;
builtin "5" ≔ Stdlib.Nat._5;
builtin "6" ≔ Stdlib.Nat._6;
builtin "7" ≔ Stdlib.Nat._7;
builtin "8" ≔ Stdlib.Nat._8;
builtin "9" ≔ Stdlib.Nat._9;
builtin "10" ≔ Stdlib.Nat._10;
builtin "+" ≔ Stdlib.Nat.+;
builtin "*" ≔ Stdlib.Nat.*;

notation ¬ prefix 35;

// testing symbols
private symbol a: Prop;
private symbol b: Prop;
private symbol c: Prop;
private symbol d: Prop;
private symbol e: Prop;

symbol Bool ≔ o;

opaque symbol neg_⊥ : π (¬ ⊥) ≔ begin refine (λ x, x) end;

// # Clause
// Clauses are encoded with list à la Church Encoding.
// This encoding is necessary because Inductive type in Lambdapi
// could not live in Prop.
constant symbol Clause : TYPE;

constant symbol clause: Set;
rule τ clause ↪ Clause;

// Nil
constant symbol ▩ : Clause;
// Cons
injective symbol ⟇: Prop → Clause → Clause;
notation ⟇ infix right 2;
// Append of two clause list
sequential symbol ++ : Clause → Clause → Clause; notation ++ infix right 3;

rule ▩ ++ $m ↪ $m
with ($x ⟇ $l) ++ $m ↪ $x ⟇ ($l ++ $m);

// Version similar to the one generated by Lambdapi induction tactic.
// symbol ind_ℂ : Π p: (Clause → Prop), π (p ▩) → (Π x0: τ o, Π x1: Clause, π (p x1) → π (p (x0 ⟇ x1))) → π (`∀ (x: Clause), p x);

symbol ind_ℂ : Π p: (Clause → Prop), π (p ▩) → (Π x0: τ o, Π x1: Clause, π (p x1) → π (p (x0 ⟇ x1))) → Π (x: Clause), π (p x);

constant symbol Clause_ind:  Π P: (Clause → Prop), Π l,
  π (P ▩) →
  (Π x: Prop, Π l: Clause, π (P l) → π (P (x ⟇ l))) →
  π (P l);

// some sanity checks
assert x y z ⊢ x ++ y ++ z ≡ x ++ (y ++ z);
assert x l m ⊢ x ⟇ l ++ m ≡ x ⟇ (l ++ m);


sequential symbol ∨_to_⟇_rw: Prop → Clause;
rule ∨_to_⟇_rw ($x ∨ $y) ↪ $x ⟇ (∨_to_⟇_rw $y)
with ∨_to_⟇_rw ⊥ ↪  ▩;

sequential symbol ⟇_to_∨_rw: Clause → Prop;
rule ⟇_to_∨_rw ($x ⟇ $y) ↪ $x ∨ (⟇_to_∨_rw $y)
with ⟇_to_∨_rw ▩ ↪ ⊥;

assert ⊢ ⟇_to_∨_rw (a ⟇ b ⟇ ▩) ≡ a ∨ b ∨ ⊥;
assert ⊢ ∨_to_⟇_rw (a ∨ b ∨ ⊥ ∨ c ∨ ⊥) ≡ (a ⟇ b ⟇ ⊥ ⟇ c ⟇ ▩);

injective symbol π̇ c: TYPE ≔ π (⟇_to_∨_rw c);

opaque symbol π̇ₗ [a] : π̇ (a ⟇ ▩)  → π a ≔
begin
  assume a Hcl_a;
  apply @∨ₑ a ⊥ a
  { apply Hcl_a }
  { assume Ha; apply Ha }
  { assume False; apply ⊥ₑ False; };
end;

// opaque injective symbol π p : TYPE ≔ π (¬ (¬ p));

// Introduction rule for Clause
// construct `p ⟇ q` from a clause with only `p`
opaque symbol ⟇ᵢ₁ [p q] : π̇ (p ⟇ ▩) → π̇ (p ⟇ q) ≔
begin
  assume p q Hp;
  apply ∨ₑ Hp
  { assume Hpi_p; apply ∨ᵢ₁;  apply Hpi_p }
  { assume Hbot; apply ⊥ₑ; apply Hbot }
end;

// construct `p ⟇ q` from a proof of `p`
opaque symbol ⟇ᵢ₁' [p q] : π p → π̇ (p ⟇ q) ≔
begin
  assume p q Hp; apply ∨ᵢ₁; apply Hp
end;

opaque symbol ⟇ᵢ₂ [p q] : π̇ q → π̇ (p ⟇ q) ≔
begin
  assume p q Hq; apply ∨ᵢ₂; apply Hq
end;

// Elimination rule for clause
opaque symbol ⟇ₑ [p q r] : π̇ (p ⟇ q) → (π̇ (p ⟇ ▩) → π̇ r) → (π̇ q → π̇ r) → π̇ r ≔
begin
  assume p q r Hpq Hpr Hqr;
  apply ∨ₑ Hpq
  { assume Hp; apply Hpr (∨ᵢ₁ Hp) }
  { assume Hq; apply Hqr Hq }
end;


opaque symbol ++_to_∨ a b : π ((⟇_to_∨_rw (a ++ b)) ⇔  ((⟇_to_∨_rw a) ∨ (⟇_to_∨_rw b))) ≔
begin
  assume a b;
  apply Clause_ind (λ u, (⟇_to_∨_rw (u ++ b)) ⇔  ((⟇_to_∨_rw u) ∨ (⟇_to_∨_rw b))) a
    {
      apply ∧ᵢ
        { assume H; apply ∨ᵢ₂; apply H }
        {
          assume H;
          apply ∨ₑ H { assume H⊥; apply ⊥ₑ; apply H⊥ } { assume H1;  apply H1}
        }
    }
    {
      assume x l Hir;
      apply ∧ᵢ
      { assume H;   apply ∨ₑ H
        {
          assume Hx;
          apply ∨ᵢ₁;
          apply ∨ᵢ₁;
          apply Hx;
        }
        {
          assume Hl++b;
          have tmp: π ((x ∨ (⟇_to_∨_rw l ∨ ⟇_to_∨_rw b)) ⇒ ((x ∨ ⟇_to_∨_rw l) ∨ ⟇_to_∨_rw b)) {
            refine ∧ₑ₁ (Stdlib.Prop.∨_assoc  x (⟇_to_∨_rw l) (⟇_to_∨_rw b));  //((x ∨ (⟇_to_∨_rw l ∨ ⟇_to_∨_rw b)) ⇒ ((x ∨ ⟇_to_∨_rw l) ∨ ⟇_to_∨_rw b))
          };
          apply tmp;
          apply ∨ₑ H
          {
            assume Hx;  apply ∨ᵢ₁; apply Hx
          }
          {
            assume Hl_or_b;
            apply ∨ᵢ₂;
            have HirLeft: π ((⟇_to_∨_rw (l ++ b) ⇒ (⟇_to_∨_rw l ∨ ⟇_to_∨_rw b))) {
                refine (∧ₑ₁ Hir);
            };
            apply HirLeft;
            apply Hl++b
          }
        }
      }
      {
        assume H;
        apply ∨ₑ H {
            assume H1;
            apply ∨ₑ H1 {
              assume Hx;
              apply ∨ᵢ₁;
              apply Hx;
            } {
              assume H2;
              apply ∨ᵢ₂;
              have tmp: π (((⟇_to_∨_rw l ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (l ++ b))) {
                refine (∧ₑ₂ Hir);
              };
              apply tmp;
              apply ∨ᵢ₁;
              apply H2
            }
        } {
          assume H1;
          apply ∨ᵢ₂;
          have tmp: π (((⟇_to_∨_rw l ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (l ++ b))) {
                refine (∧ₑ₂ Hir);
              };
              apply tmp;
              apply ∨ᵢ₂;
              apply H1
        }
      }
    }
end;

constant symbol nnpp_eq p : π ((¬ ¬ p) = p);

// Axiom propositional_extensionality: forall (P Q : Prop), (P <-> Q) -> P = Q.
// τ o ↪ Prop
constant symbol prop_ext [p: Prop] [q: Prop]: π (p ⇔ q) → π (p = q);

opaque symbol ⟺_ext [p: Prop] [q: Prop]:  π (p = q) → π (p ⇔ q) ≔
begin
  assume p q Heq;  rewrite Heq; apply ⇔_refl
end;

opaque symbol iff_equiv_eq p q: π ((p ⇔ q) = (p = q)) ≔
begin
  assume p q;
  apply prop_ext;
  apply ∧ᵢ
  { assume Hiff; apply prop_ext Hiff }
  { assume Heq; rewrite Heq; apply ⇔_refl }
end;

opaque symbol morgan1 p q : π (¬ (p ∧ q) = (¬ p ∨ ¬ q)) ≔
begin
  assume p q;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    apply  not_and_or H
  }
  {
    assume H;
    refine or_not_and H
  }
end;

opaque symbol morgan2 p q : π (¬ (p ∨ q) = (¬ p ∧ ¬ q)) ≔
begin
  assume p q;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    refine not_or_and H
  }
  {
    assume H;
    refine and_not_or H
  }
end;

opaque symbol distributive_or p q r : π ((p ∨ (q ∧ r)) = ((p ∨ q) ∧ (p ∨ r))) ≔
begin
  assume p q r;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    apply ∧ᵢ
    {
      apply ∨ₑ H
      { assume Hp; apply ∨ᵢ₁; refine Hp }
      { assume Hqr; apply ∨ᵢ₂; refine ∧ₑ₁ Hqr }
    }
    {
      apply ∨ₑ H
      { assume Hp; apply ∨ᵢ₁; refine Hp }
      { assume Hqr; apply ∨ᵢ₂; refine ∧ₑ₂ Hqr }
    }
  }
  {
    assume H;
    have H1: π (p ∨ q) { apply ∧ₑ₁ H  };
    have H2: π (p ∨ r) { apply ∧ₑ₂ H  };
    apply ∨ₑ H1
    {
        assume Hp;
        apply ∨ₑ H2
        {
          assume Hp';
          apply ∨ᵢ₁;
          apply Hp';
        }
        {
          assume Hr;
          apply ∨ᵢ₁;
          apply Hp;
        }
    }
    {
      assume Hq;
      apply ∨ₑ H2
        {
          assume Hp';
          apply ∨ᵢ₁;
          apply Hp';
        }
        {
          assume Hr;
          apply ∨ᵢ₂;
          apply ∧ᵢ
          { refine Hq }
          { refine Hr }
        }
    };
  }
end;

opaque symbol distributive_and p q r : π ((p ∧ (q ∨ r)) = ((p ∧ q) ∨ (p ∧ r))) ≔
begin
  assume p q r;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    have Hp: π p { apply ∧ₑ₁ H };
    have Hqorr: π (q ∨ r) { apply ∧ₑ₂ H };
    apply ∨ₑ Hqorr
    {
      assume Hq;
      apply ∨ᵢ₁;
      apply ∧ᵢ { refine Hp } { refine Hq }
    }
    {
      assume Hr;
      apply ∨ᵢ₂;
      apply ∧ᵢ { refine Hp } { refine Hr  }
    }
  }
  {
    assume H;
    apply ∨ₑ H
    {
      assume Hpandq;
      apply ∧ᵢ { refine ∧ₑ₁ Hpandq  } { apply ∨ᵢ₁; refine ∧ₑ₂ Hpandq }
    }
    {
      assume Hpandr;
      apply ∧ᵢ { refine ∧ₑ₁ Hpandr  } { apply ∨ᵢ₂; refine ∧ₑ₂ Hpandr }
    }
  }
end;

opaque symbol or_idempotent p : π ((p ∨ p) = p) ≔
begin
  assume p;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume Hporp;
    apply ∨ₑ Hporp
    { assume Hp; refine Hp }
    { assume Hp; refine Hp }
  }
  {
    assume Hp;
    apply ∨ᵢ₁;
    refine Hp
  }
end;

opaque symbol and_idempotent p : π ((p ∧ p) = p) ≔
begin
  assume p;
  apply prop_ext;
  apply ∧ᵢ
  { assume Hpandp; apply ∧ₑ₁ Hpandp; }
  {
    assume Hp;
    apply ∧ᵢ { refine Hp } { refine Hp }
  }
end;

opaque symbol imp_eq_or p q: π (((¬ p) ∨ q) =  (p ⇒ q)) ≔
begin
  assume p q;
  apply prop_ext;
  apply ∧ᵢ
  { assume Hor; refine or_to_imply Hor;  }
  { assume Himp; apply imply_to_or Himp }
end;

opaque symbol contrapos [p q] : π ((p ⇒ q)  ⇔ (¬ q ⇒ ¬ p)) ≔
begin

  assume p q;
  apply ∧ᵢ
  {
    assume Himp;
    assume Hnq;
    assume Hp;
    have Hq: π q
    {  apply Himp Hp };
    apply ¬ₑ Hnq Hq
  }
  {
    assume Himp;
    assume Hp;
    have Hor: π ((¬ ¬ q) ∨ ¬ p) {
      rewrite imp_eq_or;
      refine Himp
    };
    apply ∨ₑ Hor
    { assume Hnnq; rewrite left  nnpp_eq; refine Hnnq }
    { assume Hnp; apply  ¬ₑ Hnp Hp }
  };
end;

// Alias name for `¬¬ₑ`
opaque symbol contradiction p : (π (¬ p) → π ⊥) → π p ≔
begin
  assume p Hnp;
  refine ¬¬ₑ p Hnp
end;

// // Hilbert epsilon operator/choice
symbol ϵ  [a]: (τ a → Prop) → τ a; notation ϵ quantifier;

constant symbol ϵᵢ [a] x (p: τ a → Prop) : π (p x) → π (p (ϵ p));
constant symbol ϵ_det [a p q]: Π (x: τ a), π ((p x) ⇔ (q x)) → π (ϵ p = ϵ q);

opaque symbol ϵ_to_∃ [a] p: π ((`∃ (x : τ a),  p x) = p (`ϵ (x : τ a), p x)) ≔
begin
  assume a p;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    apply ∃ₑ H;
    assume x H1;
    apply ϵᵢ x (λ u, (p u)) H1;
  }
  {
    refine (∧ₑ₂ (@contrapos (p (`ϵ x, p x) ) (`∃ x, p x))) _;
    assume H;
    have H1: π (`∀ x, ¬ p x) { apply ((∧ₑ₁ (nex_forall p)) H) };
    refine H1 (`ϵ x, p x);
  }
end;

opaque symbol ϵ_to_∀ [a] p: π ((`∀ (x : τ a), p x) = p (`ϵ (x : τ a), (¬ p x))) ≔
begin
  assume a p;
  apply prop_ext;
  apply ∧ᵢ
  {
    assume H;
    apply H (`ϵ x, ¬ (p x)) 
  }
  {
    simplify;
    refine (∧ₑ₂ (@contrapos (p (`ϵ x, ¬ (p x)) ) (`∀ x, p x))) _;
    assume H;
    
    have H1: π (`∃ x, ¬ p x) { refine ((∧ₑ₁ (nforall_ex p)) H) };
    apply ∃ₑ H1;
    assume x Hnpx;
    refine ϵᵢ x (λ u, ¬ (p u)) Hnpx;
  }
end;

opaque  symbol and_identity_r x : π ((x ∧ ⊤) = x) ≔
begin
  assume x;
  apply prop_ext;
  apply ∧ᵢ
  { assume Hand; apply ∧ₑ₁ Hand  }
  { assume Hx; apply ∧ᵢ { refine Hx } { refine ⊤ᵢ } }
end;

opaque  symbol and_identity_l x : π ((⊤ ∧ x) = x) ≔
begin
  assume x;
  apply prop_ext;
  apply ∧ᵢ
  { assume Hand; apply ∧ₑ₂ Hand  }
  { assume Hx; apply ∧ᵢ { refine ⊤ᵢ } { refine Hx } }
end;

opaque  symbol and_domination x : π ((x ∧ ⊥) = ⊥) ≔
begin
  assume x;
  apply prop_ext;
  apply ∧ᵢ
  {  assume Hand; apply ∧ₑ₂ Hand  }
  {  assume Hx; apply ⊥ₑ Hx }
end;

opaque  symbol or_identity_l x : π ((⊥ ∨ x) = x) ≔
begin
  assume x;
  apply prop_ext;
  apply ∧ᵢ
  {  assume Hor; apply ∨ₑ Hor { assume Hbot; apply ⊥ₑ; refine Hbot } { assume Hx; refine Hx }  }
  {  assume Hx; apply ∨ᵢ₂; refine Hx }
end;

opaque  symbol or_identity_r x : π ((x ∨ ⊥) = x) ≔
begin
  assume x;
  apply prop_ext;
  apply ∧ᵢ
  {  assume Hor; apply ∨ₑ Hor { assume Hx; refine Hx } { assume Hbot; apply ⊥ₑ; refine Hbot } }
  {  assume Hx; apply ∨ᵢ₁; refine Hx }
end;

opaque symbol ϵ_equiv_∃' [a p] : π ((`∃ (x: τ a), p x) = (p (`ϵ x, p x))) ≔
begin
  assume a p;
  apply prop_ext;
  apply ∧ᵢ
  {
    
    assume Hexist;
    apply ∃ₑ Hexist;
    assume x Hpx;
    apply ϵᵢ x (λ u, p u);
    apply Hpx
  }
  {
    
    assume Heps;
    apply ∃ᵢ (`ϵ x, p x);
    apply Heps
  }
end;

opaque symbol ϵ_equiv_∃ [a p] : π ((`∃ x: τ a, p x) ⇔ (p (`ϵ x, p x))) ≔
begin
  assume a p;
  apply ∧ᵢ
  {
    
    assume Hexist;
    apply ∃ₑ Hexist;
    assume x Hpx;
    apply ϵᵢ x (λ u, p u);
    apply Hpx
  }
  {
    
    assume Heps;
    apply ∃ᵢ (`ϵ x, p x);
    apply Heps
  }
end;

constant symbol ite [a] (c: τ o) (t e: τ a): τ a;

constant symbol ite_ind [a] : Π (c: τ o) (t e: τ a) p,
  (π c → π (p t))
  → ((π c → π ⊥) → π (p e))
  → π (p (@ite a c t e));

compute ite true true false;


opaque symbol ∨_to_⟇ a b: π (a ∨ b) → π̇ (a ⟇ b ⟇ ▩) ≔
begin
  assume a b Haorb;
  apply ∨ₑ Haorb
  { assume Ha;  apply ∨ᵢ₁; apply Ha }
  {  assume Hb; apply ∨ᵢ₂; apply ∨ᵢ₁; apply Hb }
end;

opaque symbol cong [a b] (f:τ a → τ b) [x x':τ a] : π(x = x') → π(f x = f x') ≔
begin
  assume a b f x x' xx'; rewrite xx'; reflexivity;
end;

opaque symbol cong2 [a b c] (f:τ a → τ b → τ c):
  Π [x x':τ a], π (x = x') → Π [y y':τ b], π (y = y') → π (f x y = f x' y') ≔
begin
  assume a b c f x x' xx' y y' yy'; rewrite xx'; rewrite yy'; reflexivity
end;

opaque symbol cong3 [a b c d] (f:τ a → τ b → τ c → τ d):
  Π [x x':τ a], π (x = x') → Π [y y':τ b], π (y = y') → Π [z z':τ c], π (z = z') → π (f x y z = f x' y' z') ≔
begin
  assume a b c d f x x' xx' y y' yy' z z' zz'; rewrite xx'; rewrite yy'; rewrite zz'; reflexivity
end;

opaque symbol cong4 [a1 a2 a3 a4 a5] (f : τ a1 → τ a2 → τ a3 → τ a4 → τ a5):
  Π [x1 x1':τ a1], π (x1 = x1') →
  Π [x2 x2':τ a2], π (x2 = x2') →
  Π [x3 x3':τ a3], π (x3 = x3') →
  Π [x4 x4':τ a4], π (x4 = x4') →
  π (f x1 x2 x3 x4 = f x1' x2' x3' x4') ≔
begin
  assume a1 a2 a3 a4 a5 f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  reflexivity
end;

opaque symbol cong5 [a1 a2 a3 a4 a5 a6] (f : τ a1 → τ a2 → τ a3 → τ a4 → τ a5 → τ a6):
  Π [x1 x1':τ a1], π (x1 = x1') →
  Π [x2 x2':τ a2], π (x2 = x2') →
  Π [x3 x3':τ a3], π (x3 = x3') →
  Π [x4 x4':τ a4], π (x4 = x4') →
  Π [x5 x5':τ a5], π (x5 = x5') →
  π (f x1 x2 x3 x4 x5 = f x1' x2' x3' x4' x5') ≔
begin
  assume a1 a2 a3 a4 a5 a6 f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  assume x5 x5' H5;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  rewrite H5;
  reflexivity
end;

opaque symbol cong6 [a1 a2 a3 a4 a5 a6 a7] (f : τ a1 → τ a2 → τ a3 → τ a4 → τ a5 → τ a6 → τ a7):
  Π [x1 x1':τ a1], π (x1 = x1') →
  Π [x2 x2':τ a2], π (x2 = x2') →
  Π [x3 x3':τ a3], π (x3 = x3') →
  Π [x4 x4':τ a4], π (x4 = x4') →
  Π [x5 x5':τ a5], π (x5 = x5') →
  Π [x6 x6':τ a6], π (x6 = x6') →
  π (f x1 x2 x3 x4 x5 x6 = f x1' x2' x3' x4' x5' x6') ≔
begin
  assume a1 a2 a3 a4 a5 a6 a7 f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  assume x5 x5' H5;
  assume x6 x6' H6;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  rewrite H5;
  rewrite H6;
  reflexivity
end;

opaque symbol cong7 [a1 a2 a3 a4 a5 a6 a7 a8] (f : τ a1 → τ a2 → τ a3 → τ a4 → τ a5 → τ a6 → τ a7 → τ a8):
  Π [x1 x1':τ a1], π (x1 = x1') →
  Π [x2 x2':τ a2], π (x2 = x2') →
  Π [x3 x3':τ a3], π (x3 = x3') →
  Π [x4 x4':τ a4], π (x4 = x4') →
  Π [x5 x5':τ a5], π (x5 = x5') →
  Π [x6 x6':τ a6], π (x6 = x6') →
  Π [x7 x7':τ a7], π (x7 = x7') →
  π (f x1 x2 x3 x4 x5 x6 x7 = f x1' x2' x3' x4' x5' x6' x7') ≔
begin
  assume a1 a2 a3 a4 a5 a6 a7 a8 f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  assume x5 x5' H5;
  assume x6 x6' H6;
  assume x7 x7' H7;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  rewrite H5;
  rewrite H6;
  rewrite H7;
  reflexivity
end;

opaque symbol cong8 [a1 a2 a3 a4 a5 a6 a7 a8 a9] (f : τ a1 → τ a2 → τ a3 → τ a4 → τ a5 → τ a6 → τ a7 → τ a8 → τ a9):
  Π [x1 x1':τ a1], π (x1 = x1') →
  Π [x2 x2':τ a2], π (x2 = x2') →
  Π [x3 x3':τ a3], π (x3 = x3') →
  Π [x4 x4':τ a4], π (x4 = x4') →
  Π [x5 x5':τ a5], π (x5 = x5') →
  Π [x6 x6':τ a6], π (x6 = x6') →
  Π [x7 x7':τ a7], π (x7 = x7') →
  Π [x8 x8':τ a8], π (x8 = x8') →
  π (f x1 x2 x3 x4 x5 x6 x7 x8 = f x1' x2' x3' x4' x5' x6' x7' x8') ≔
begin
  assume a1 a2 a3 a4 a5 a6 a7 a8 a9 f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  assume x5 x5' H5;
  assume x6 x6' H6;
  assume x7 x7' H7;
  assume x8 x8' H8;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  rewrite H5;
  rewrite H6;
  rewrite H7;
  rewrite H8;
  reflexivity
end;

opaque symbol ite1' [c t e] : π (ite c t e ⇒ c ∨ e) ≔
begin
  assume c t e;
  refine ite_ind c t e (λ u, u ⇒ (c ∨ e)) _ _
  {
    assume Hc;
    
    assume Ht;
    apply ∨ᵢ₁;
    apply Hc
  }
  {
    assume Hnc;
    
    assume He;
    apply ∨ᵢ₂;
    apply He
  }
end;

opaque symbol ite1 (c t e: τ o) : π (ite c t e) → π̇ (c ⟇ e ⟇ ▩) ≔
begin
  assume c t e H;
  simplify;
  rewrite or_identity_r;
  apply ( (@ite1' c t e)) H;
end;

opaque symbol ite2' [c t e] : π (ite c t e ⇒ ((¬ c) ∨ t)) ≔
begin
  assume c t e;
  refine ite_ind c t e (λ u, u ⇒ (¬ c ∨ t)) _ _
  {
    assume Hc;
    
    assume Ht;
    apply ∨ᵢ₂;
    apply Ht
  }
  {
    assume Hc;
    
    assume He;
    remove He;
    apply ∨ᵢ₁;
    simplify;
    refine Hc
  };
end;

opaque symbol ite2 (c t e: τ o) : π (ite c t e) → π̇ ((¬ c) ⟇ t ⟇ ▩) ≔
begin
  assume c t e H;
  simplify;
  rewrite or_identity_r;
  apply ( (@ite2' c t e)) H;
end;

// Use it to unfold the definition of `¬`.
// The tactic simplify is to agressive.
opaque symbol negdef p : π ((p ⇒ ⊥) = ¬ p) ≔
begin
  simplify; reflexivity
end;

opaque symbol ite_pos1 [c t e] : π̇ ((¬ (ite c t e)) ⟇ c ⟇ e ⟇ ▩) ≔
begin
  assume c t e;
  apply imply_to_or;
  
  assume H;
  simplify;
  rewrite or_identity_r;
  apply ( (@ite1' c t e)) H;
end;

opaque symbol ite_pos2 [c t e] : π̇ (¬ (ite c t e) ⟇ ¬ c ⟇ t ⟇ ▩) ≔
begin
  assume c t e;
  apply imply_to_or;
  
  assume H;
  simplify;
  rewrite or_identity_r;
  apply ( (@ite2' c t e)) H;
end;

opaque symbol ite_neg1 [c t e] : π̇ ((ite c t e) ⟇ c ⟇ ¬ e ⟇ ▩) ≔
begin
  assume c t e;
  simplify;
  rewrite or_identity_r;
  apply ite_ind c t e (λ u, u ∨ (c ∨ (e ⇒ ⊥)))
  {
    assume Hc; apply ∨ᵢ₂; apply ∨ᵢ₁; refine Hc
  }
  {
    assume Hnc; rewrite ∨_com;
    rewrite ∨_assoc;
    apply ∨ᵢ₂;
    rewrite ∨_com;
    apply em;
  };
end;

opaque symbol ite_neg2 [c t e] : π̇ ((ite c t e) ⟇ ¬ c ⟇ ¬ t ⟇ ▩) ≔
begin
  assume c t e;
  simplify;
  rewrite or_identity_r;
  apply ite_ind c t e (λ u, u ∨ ((c ⇒ ⊥)∨ (t ⇒ ⊥)))
  {
    assume Hnc; rewrite ∨_com;
    rewrite ∨_assoc;
    apply ∨ᵢ₂;
    rewrite ∨_com;
    apply em;
  }
  {
    assume Hc; apply ∨ᵢ₂; apply ∨ᵢ₁; refine Hc
  }
end;

opaque symbol not_ite1' [c t e] : π (¬ (ite c t e) ⇒ c ∨ ¬ e) ≔
begin
  assume c t e;
  refine ite_ind c t e (λ u, ¬ u ⇒ c ∨ ¬ e) _ _
  {
    assume Hc;
    
    assume Hnt;
    apply ∨ᵢ₁;
    refine Hc;
  }
  {
    assume Hcimpbot;
    
    assume Hne;
    apply ∨ᵢ₂;
    refine Hne
  }
end;

opaque symbol not_ite1 [c t e] : π (¬ (ite c t e)) → π̇( c ⟇ ¬ e ⟇ ▩) ≔
begin
  assume c t e H;
  simplify;
  rewrite or_identity_r;
  apply ( (@not_ite1' c t e) H);
end;

opaque symbol not_ite2' [c t e] : π (¬ (ite c t e) ⇒ ¬ c  ∨ ¬ t) ≔
begin
  assume c t e;
  refine ite_ind c t e (λ u, ¬ u ⇒ ¬ c  ∨ ¬ t) _ _
  { assume Hc;  assume Hnt; apply ∨ᵢ₂; refine Hnt }
  { assume Hcimpbot;  assume Hne; apply ∨ᵢ₁; simplify; refine Hcimpbot; }
end;

opaque symbol not_ite2 [c t e] : π (¬ (ite c t e)) → π̇(¬ c ⟇ ¬ t ⟇ ▩) ≔
begin
  assume c t e H;
  simplify;
  rewrite or_identity_r;
  apply ( (@not_ite2' c t e) H);
end;

opaque symbol ite_cong [a] [c c': τ o] [t t' e e': τ a] : π (c = c') → π (t = t') → π (e = e') → π̇(ite c t e = ite c' t' e' ⟇ ▩) ≔
begin
  assume a c c' t t' e e' Hcc' Htt' Hee';
  simplify;
  rewrite or_identity_r;
  rewrite Hcc';
  rewrite Htt';
  rewrite Hee';
  reflexivity
end;

symbol xor a b ≔ ((¬ a) ∧ b) ∨ (a ∧ (¬ b));

opaque symbol xor_pos1 [a b] : π̇ (¬ (xor a b) ⟇ a ⟇ b ⟇ ▩) ≔
begin
  assume a b;
  simplify;
  apply imply_to_or;
  
  assume H;
  apply ∨ₑ H
  { assume Hnab; apply ∨ᵢ₂;  apply ∨ᵢ₁; apply ∧ₑ₂ Hnab }
  { assume Hnab; apply ∨ᵢ₁; apply ∧ₑ₁ Hnab }
end;

opaque symbol xor_pos2 [a b] : π̇ (¬ (xor a b) ⟇ ¬ a ⟇ ¬ b ⟇ ▩) ≔
begin
  assume a b;
  simplify;
  apply imply_to_or;
  
  assume H;
  apply ∨ₑ H
  { assume Hnab; apply ∨ᵢ₁; apply ∧ₑ₁ Hnab }
  { assume Hnab; apply ∨ᵢ₂;  apply ∨ᵢ₁; apply ∧ₑ₂ Hnab }
end;

opaque symbol xor_neg1 [a b] : π̇ ((xor a b) ⟇ a ⟇ ¬ b ⟇ ▩) ≔
begin
  simplify;
  assume a b;
  rewrite ∨_assoc;
  rewrite ∨_com;
  rewrite distributive_or;
  apply ∧ᵢ
  {
    rewrite or_identity_r;
    rewrite ∨_assoc;
    apply ∨ᵢ₂;
    rewrite ∨_com;
    rewrite left ∨_assoc;
    apply ∨ᵢ₁;
    rewrite ∨_com;
    apply em
  }
  {
    rewrite ∨_assoc;
    apply ∨ᵢ₂;
    rewrite ∨_assoc;
    apply ∨ᵢ₂;
    rewrite ∨_com;
    rewrite left ∨_assoc;
    apply ∨ᵢ₁;
    apply em
  }
end;

opaque symbol xor_neg2 [a b] : π̇ ((xor a b) ⟇ ¬ a ⟇ b ⟇ ▩) ≔
begin
  simplify;
  assume a b;
  rewrite ∨_assoc;
  rewrite ∨_com;
  rewrite distributive_or;
  apply ∧ᵢ
  {
    rewrite ∨_assoc;
    rewrite ∨_com;
    rewrite distributive_or;
    apply ∧ᵢ
    {
      rewrite ∨_assoc;
      apply ∨ᵢ₂;
      rewrite ∨_com;
      apply em
    }
    {
      rewrite ∨_com;
      rewrite left ∨_assoc;
      apply ∨ᵢ₁;
      rewrite ∨_com;
      rewrite ∨_assoc;
      apply ∨ᵢ₂;
      rewrite or_identity_r;
      apply em
    }
  }
  {
    rewrite ∨_assoc;
    rewrite ∨_com;
    rewrite distributive_or;
    apply ∧ᵢ
    {
      rewrite ∨_com;
      rewrite left ∨_assoc;
      apply ∨ᵢ₁;
      rewrite left ∨_assoc;
      apply ∨ᵢ₁;
      apply em
    }
    {
      rewrite ∨_com;
      rewrite left ∨_assoc;
      rewrite or_identity_r;
      apply ∨ᵢ₁;
      rewrite ∨_com;
      rewrite ∨_assoc;
      apply ∨ᵢ₂;
      apply em
    }
  }
end;

// // i ▷ 𝜑1 ∨ ⋯ ∨ 𝜑n
// // j ▷ 𝜑1 , ⋯ , 𝜑n
constant symbol or [a b] : π̇ ((a ∨ b) ⟇ ▩) → π̇ (∨_to_⟇_rw  (a ∨ b));

opaque symbol not_not x : π̇ ( (¬ (¬ (¬ x))) ⟇ x ⟇ ▩) ≔
begin
  assume x;
  apply imply_to_or;
  assume H;
  apply ∨ᵢ₁; 
  refine ¬¬ₑ x H
end;

opaque symbol implies [φ₁ φ₂] : π (φ₁ ⇒ φ₂) → π̇ (¬ φ₁ ⟇ φ₂ ⟇ ▩) ≔
begin
  assume φ₁ φ₂ Hφ₁⇒φ₂;
  apply imply_to_or;
  
  assume πφ₁;
  apply ∨ᵢ₁;
  apply  Hφ₁⇒φ₂ πφ₁
end;

opaque symbol not_implies1 [φ₁ φ₂] : π (¬ (φ₁ ⇒ φ₂)) → π̇ (φ₁ ⟇ ▩) ≔
begin
  assume φ₁ φ₂ Hnot_φ₁⇒φ₂;
  apply ∨ᵢ₁;
  apply ∧ₑ₁ (imply_to_and Hnot_φ₁⇒φ₂)
end;

opaque symbol not_implies2 [φ₁ φ₂] : π (¬ (φ₁ ⇒ φ₂)) →  π̇ (¬ φ₂ ⟇ ▩) ≔
begin
  assume φ₁ φ₂ Hnot_φ₁⇒φ₂;
  apply ∨ᵢ₁;
  apply ∧ₑ₂ (imply_to_and Hnot_φ₁⇒φ₂)
end;

opaque symbol implies_neg1 [φ₁ φ₂] : π̇ (φ₁ ⇒ φ₂ ⟇ φ₁ ⟇ ▩) ≔
begin
  assume φ₁ φ₂;
  simplify;
  rewrite left imp_eq_or;
  rewrite left ∨_assoc;
  apply ∨ᵢ₁;
  rewrite .[(¬ φ₁) ∨ φ₂] ∨_com;
  rewrite ∨_assoc;
  apply ∨ᵢ₂;
  rewrite ∨_com;
  apply em
end;

opaque symbol implies_neg2 [φ₁ φ₂] : π̇ (φ₁ ⇒ φ₂ ⟇ ¬ φ₂ ⟇ ▩) ≔
begin
  assume φ₁ φ₂;
  simplify;
  rewrite left imp_eq_or;
  rewrite left ∨_assoc;
  apply ∨ᵢ₁;
  rewrite ∨_assoc;
  apply ∨ᵢ₂;
  apply em
end;

opaque symbol equiv1 [φ₁ φ₂] : π̇ (φ₁ = φ₂ ⟇ ▩) → π̇ ((¬ φ₁) ⟇ φ₂ ⟇ ▩) ≔
begin
  assume φ₁ φ₂ H1;
  apply ∨ₑ H1
  {
    assume Hequiv;
    have Hequiv':  π (φ₁ ⇔ φ₂) { apply ⟺_ext; apply Hequiv };
    have H2: π (φ₁ ⇒ φ₂) { apply ∧ₑ₁ Hequiv' };
    have H3: π (φ₂ ⇒ φ₁) { apply ∧ₑ₂ Hequiv' };
    have Hassoc: π (((¬ φ₁) ∨ (φ₂ ∨ ⊥)) ⇔  (((¬ φ₁) ∨ φ₂) ∨ ⊥)) {
      apply (@Stdlib.Prop.∨_assoc (¬ φ₁) φ₂ ⊥);
    };
    have Hassoc_left: π ((((¬ φ₁) ∨ φ₂) ∨ ⊥)  ⇒  ((¬ φ₁) ∨ (φ₂ ∨ ⊥))) {
      refine ∧ₑ₂ Hassoc
    };
    apply  Hassoc_left;
    apply ∨ᵢ₁;
    apply imply_to_or;
    refine H2;
  }
  {
    assume Hbot;
    apply ∨ᵢ₂;
    apply ∨ᵢ₂;
    apply Hbot;
  }
end;

opaque symbol equiv2 [φ₁ φ₂] : π̇ (φ₁ = φ₂ ⟇ ▩)  → π̇ (φ₁ ⟇ (¬ φ₂) ⟇ ▩) ≔
begin
  assume φ₁ φ₂ H1;
  apply ∨ₑ H1
  {
    assume Hequiv;
    have Hequiv':  π (φ₁ ⇔ φ₂) { apply ⟺_ext; apply Hequiv };
    have H2: π (φ₁ ⇒ φ₂) { apply ∧ₑ₁ Hequiv' };
    have H3: π (φ₂ ⇒ φ₁) { apply ∧ₑ₂ Hequiv' };
    have Hassoc: π ((φ₁ ∨ ((¬ φ₂) ∨ ⊥)) ⇔  ((φ₁ ∨ (¬ φ₂)) ∨ ⊥)) {
      apply (@Stdlib.Prop.∨_assoc φ₁ (¬ φ₂) ⊥);
    };
    have Hassoc_left: π (((φ₁ ∨ (¬ φ₂)) ∨ ⊥)  ⇒  (φ₁ ∨ ((¬ φ₂) ∨ ⊥))) {
      refine ∧ₑ₂ Hassoc
    };
    apply  Hassoc_left;
    apply ∨ᵢ₁;
    rewrite ∨_com;
    apply imply_to_or;
    refine H3;
  }
  {
    assume Hbot;
    apply ∨ᵢ₂;
    apply ∨ᵢ₂;
    apply Hbot;
  }
end;

opaque symbol equiv_pos1 [φ₁ φ₂] : π̇ ((¬ (φ₁ = φ₂)) ⟇ φ₁ ⟇ ¬ φ₂ ⟇ ▩) ≔
begin
  simplify;
  assume p q;
  apply imply_to_or;
  assume Heq;
  rewrite Heq;
  rewrite left ∨_assoc;
  apply ∨ᵢ₁;
  apply em
end;

opaque symbol equiv_pos2 [φ₁ φ₂] : π̇ ((¬ (φ₁ = φ₂)) ⟇ (¬ φ₁) ⟇ φ₂ ⟇ ▩) ≔
begin
  simplify;
  assume p q;
  apply imply_to_or;
  assume Heq;
  rewrite or_identity_r;
  rewrite ∨_com;
  rewrite Heq;
  apply em
end;

opaque symbol equiv_neg1 [φ₁ φ₂] : π̇ ((φ₁ = φ₂) ⟇ ¬ φ₁ ⟇ ¬ φ₂ ⟇ ▩) ≔
begin
  simplify;
  assume p q;
  rewrite or_identity_r;
  rewrite ∨_com;
  rewrite ∨_assoc;
  apply imply_to_or;
  
  assume Hp;
  apply imply_to_or;
  
  assume Hq;
  apply prop_ext;
  apply ∧ᵢ
  {  assume Hp'; apply Hq }
  {  assume Hq'; apply Hp }
end;

opaque symbol equiv_neg2 [φ₁ φ₂] : π̇ ((φ₁ = φ₂) ⟇ φ₁ ⟇ φ₂ ⟇ ▩) ≔
begin
  simplify;
  assume p q;
  rewrite or_identity_r;
  rewrite left iff_equiv_eq;
  rewrite ∨_com;
  simplify;
  rewrite distributive_or; //(p ∨ q) (p ⇒ q) (q ⇒ p);
  apply ∧ᵢ
  {
    rewrite left imp_eq_or;
    rewrite ∨_assoc;
    rewrite .[(¬ p) ∨ q] ∨_com;
    rewrite left  .[q ∨ (q ∨ ¬ p)] ∨_assoc;
    rewrite or_idempotent;
    rewrite .[q ∨ (¬ p)] ∨_com;
    rewrite left ∨_assoc;
    apply ∨ᵢ₁;
    apply em
  }
  {
    rewrite left imp_eq_or;
    rewrite left ∨_assoc;
    rewrite .[p ∨ q] ∨_com;
    rewrite .[((q ∨ p) ∨ ¬ q)] ∨_assoc;
    apply ∨ᵢ₁;
    rewrite .[p ∨ ¬ q] ∨_com;
    rewrite left ∨_assoc;
    apply ∨ᵢ₁;
    apply em
  }
end;

opaque symbol implies_pos [φ₁ φ₂] : π̇ ((¬ (φ₁ ⇒ φ₂)) ⟇ ¬ φ₁ ⟇ φ₂ ⟇ ▩) ≔
begin
  simplify;
  assume x y;
  rewrite or_identity_r;
  rewrite left imp_eq_or (x ⇒ y) ⊥;
  rewrite left imp_eq_or x ⊥;
  rewrite left imp_eq_or;
  rewrite or_identity_r;
  rewrite or_identity_r;
  rewrite ∨_com;
  refine @em ((x ⇒ ⊥) ∨ y)
end;

opaque symbol not_symm [a] [x y: τ a] : π (¬ (x = y) ⇒ (¬ (y = x))) ≔
begin
  assume a x y H;
  assume H2;
  apply H;
  symmetry;
  apply H2
end;

symbol trans [U] [a b c: τ U]: π̇ (a = b ⟇ ▩) → π̇ (b = c ⟇ ▩) → π̇ (a = c ⟇ ▩) ≔
begin
  assume U a b c H1 H2;
  apply ∨ᵢ₁;
  have H2': π (b = c) { apply π̇ₗ H2 };
  have H1': π (a = b) { apply π̇ₗ H1 };
  rewrite H1';
  apply H2'
end;

opaque symbol subproof [φ₁ ψ] : π φ₁ → π ψ → π̇ ((¬ φ₁) ⟇ ψ ⟇ ▩) ≔
begin
  assume φ₁ ψ Hφ₁ Hψ;
  apply ∨ᵢ₂;
  apply ∨ᵢ₁;
  apply Hψ
end;

opaque symbol forall_inst1 [a] p (x: τ a) : π (¬ (`∀ x', p x') ∨ (p x)) ≔
begin
 assume a p x;
 rewrite imp_eq_or;
 assume H;
 apply H
end;

opaque symbol forall_inst2 [a] p (x y: τ a) : π (¬ (`∀ a, `∀ b, p a b) ∨ (p x y)) ≔
begin
  assume a p x y;
  rewrite imp_eq_or;
  assume H;
  apply H
 end;

opaque symbol forall_inst3 [a] [p] (x y z: τ a) : π ((¬ (`∀ a, `∀ b, `∀ c, p a b c)) ∨ ((p x y z) ∨ ⊥)) ≔
begin
  assume a p x y z;
  apply imply_to_or;
  assume H;
  rewrite or_identity_r;
  apply H
end;

symbol Arity (a b: Set): τ nat → Set;
rule Arity $a $b 0 ↪ $b
with Arity $a $b ($n +1) ↪ $a ⤳ (Arity $a $b $n);

// # In Predicate
//
// The In predicate works with 𝔹 instead of Prop to avoid making critical pairs wiht other rules.
// If we use Prop, then we will need a rule
// ▷ `$x ⇔ $x ↪ ⊤` to replace `eq $x $h` and,
// ▷ `_ ∨ ⊤ ↪ ⊤` for `or _ true ↪ true`.
//
// This choice will create a critical pair reduction which would make any clause in the goal
// that contain the litteral ⊤ unable to compute the predicate In.
//
// To illustrate this case, consider the goal:
// ⊢ (𝜑1 ∨ ⋯ ∨ ⊤ ⋯ ∨ 𝜑𝑛), ¬𝜑k
// then we will have
// ⊢ In_∨ 𝜑k (𝜑1 ∨ ⋯ ∨ ⊤ ⋯ ∨ 𝜑𝑛)  (apply or_neg)
// ⊢ In_∨ 𝜑k ⊤  (by simplification)
// we got stuck...

// Decidable equality in 𝔹.
// Symbol = has been declared constant, it cannot be used as the head of a rewrite rule LHS.
// So we create our own eq symbol.


sequential symbol eq : Prop → Prop → 𝔹;
rule eq $x $x ↪ true
with eq $x $y ↪ false;

sequential symbol In_∧: Prop → Prop → 𝔹;
rule In_∧ $x ($h ∧ $tl) ↪ (eq $x $h)  Stdlib.Bool.or (In_∧ $x $tl)
with In_∧ $x ⊤ ↪ false;

sequential symbol In_∨: Prop → Prop → 𝔹;
rule In_∨ $x ($h ∨ $tl) ↪ (eq $x $h) Stdlib.Bool.or (In_∨ $x $tl)
with In_∨ _ ⊥ ↪ false;

sequential symbol In_∧': Prop → Prop → 𝔹;
rule In_∧' $x ($h ∧ $tl) ↪ (eq $x $h)  Stdlib.Bool.or (In_∧' $x $tl)
with In_∧' $x $h ↪ (eq $x $h);

sequential symbol In_∨': Prop → Prop → 𝔹;
rule In_∨' $x ($h ∨ $tl) ↪ (eq $x $h) Stdlib.Bool.or (In_∨' $x $tl)
with In_∨' $x $h ↪ (eq $x $h);


// symbol and_pos [φ₁__φₙ φₖ]:  π ((In_∧' φₖ φ₁__φₙ) = true) → π̇ (¬ φ₁__φₙ ⟇ φₖ ⟇ ▩);

// opaque symbol test_and_pos: π̇ ((¬ (a ∧ b ∧ c ∧ d)) ⟇ d ⟇ ▩) ≔
// begin
//   apply and_pos;
//   reflexivity;
// end;

// and_neg:  (𝜑1 ∧ ⋯ ∧ 𝜑𝑛), ¬𝜑1, … , ¬𝜑𝑛
// sequential symbol and_neg_r: Prop → Clause → 𝔹;
// rule and_neg_r ($x ∧ $tl) (($x ⇒ ⊥) ⟇ $tl2) ↪ and_neg_r $tl $tl2
// with and_neg_r ⊤ ▩ ↪ true;

