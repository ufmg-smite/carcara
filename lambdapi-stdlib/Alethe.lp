// opaque symbol test_not_and: π̇ (¬ (a ∧ b ∧ c ∧ d) ⟇ ▩) → π̇ (¬ a ⟇ ¬ b ⟇ ¬ c ⟇ ¬ d ⟇ ▩) ≔
// begin
//   assume t1;
//   apply not_and (π̇ₗ t1);
//   reflexivity
