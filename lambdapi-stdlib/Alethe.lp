/**********************************************
* N-ary rules
**********************************************/

require open Stdlib.List;

symbol literal ≔ nth ⊥;
symbol literals ≔ nths ⊥;

symbol ∈ₙ ≔ ∈ eqn;
notation ∈ₙ infix right 40;

symbol list_to_clause :  𝕃 o → Clause;
rule list_to_clause ($p ⸬ $ps) ↪ $p ⟇ (list_to_clause $ps)
with list_to_clause □ ↪ ▩;

symbol conj : 𝕃 o → τ o;
rule conj ($l1 ⸬ ($c ⸬ $l)) ↪ ($l1 ∧ conj ($c ⸬ $l))
with conj ($l1 ⸬ □) ↪ $l1 
with conj □ ↪ ⊤;

opaque symbol conj_head (c0 : τ o) (c : 𝕃 o) : 
     π (conj (c0 ⸬ c)) → π (c0) ≔
begin
    assume c0;
    induction
        {assume h1;
        refine h1}   
        {assume x0 c1 h1 h2;
        refine ∧ₑ₁ h2}
end; 

symbol indexes_shift (l: 𝕃 nat) (n : τ nat):
    π (istrue ((n +1) ∈ₙ (map (+1) l)) ⇒ istrue (n ∈ₙ l))≔
begin
  induction
      {assume n x; refine x}
      {assume n0;
      induction
          {assume h0 n h1; refine h1}
          {assume n1 l h0 h1 n2 h2;
          refine orₑ [eqn n2 n0] [eqn n2 n1 Stdlib.Bool.or ∈ eqn (n2 +1) (map (+1) l)] (eqn n2 n0 Stdlib.Bool.or (eqn n2 n1 Stdlib.Bool.or ∈ eqn n2 l)) h2 _ _
              {assume h3;
              refine orᵢ₁ (eqn n2 n1 Stdlib.Bool.or ∈ eqn n2 l) h3}
              {assume h3;
              refine orᵢ₂ (eqn n2 n0) (h1 n2 h3)}}}
end;

symbol indexes_decrement (id : τ nat) (l0: τ o) (l: 𝕃 o): 
     π ((id +1) ∈ₙ (indexes (l0 ⸬ l))) → π (id ∈ₙ (indexes l))≔
begin
    assume id l0 l;
    assume h0; 
    have H1 : π ((istrue (∈ eqn (id +1) (iota 1 (size l)))) ⇒ (istrue (∈ eqn id (iota 0 (size l)))))
        {have H2: π (iota 1 (size l) = map (+1) (iota 0 (size l)))
            {refine (eq_sym (mapS_iota (size l) 0))};
        rewrite H2;
        refine indexes_shift (iota 0 (size l)) id};
    refine H1 h0
end;


opaque symbol literal_ext (l: 𝕃 o) (l0 : τ o) (n: τ nat) : 
    π (literal l n) → π (literal (l0 ⸬ l) (n +1)) ≔
begin
    simplify;
    assume l l0 n h1;
    refine h1
end;

opaque symbol conj_tail (c0 : τ o) (c : 𝕃 o) : 
     π (conj (c0 ⸬ c)) → π (conj c) ≔
begin
    assume c0;
    induction
        {assume h1;
        refine ⊤ᵢ}   
        {assume x0 c1 h1 h2; 
        refine ∧ₑ₂ h2}
end; 

opaque symbol select (k : τ nat) (cnf: 𝕃 o) : 
    π (k ∈ₙ (indexes cnf)) → π (conj cnf) → π (literal cnf k) ≔
begin
    induction 
        {induction
            {assume h0 h1; refine h0}
            {assume x cnf h0 h1 h2; 
            refine conj_head x cnf h2}}
        {assume k h0;
        induction
            {assume b; refine ⊥ₑ b}
            {assume x xs ih h2 h3;
            have ConjImpCl : π (conj xs ⇒ literal xs k)
                {refine h0 xs (indexes_decrement k x xs h2)};
            simplify;
            refine literal_ext xs x k (ConjImpCl (conj_tail x xs h3))}}
end;

// Rule and:
// i. ▷ (𝜑1 ∧ ⋯ ∧ 𝜑𝑛)
// j. ▷ 𝜑𝑘
symbol ∧ₑₙ k l : π (k ∈ₙ (indexes l)) → π̇ (conj l ⟇ ▩) → π̇ ((literal l k ) ⟇ ▩) ≔
begin
  assume k l h1 h2;
  simplify;
  rewrite or_identity_r;
  refine select k l h1 (π̇ₗ h2)
end;


// (and_pos) ⊢ ¬ (x1 ∧ ... ∧ xn), xk ≡ (x1 ∧ ... ∧ xn) ⊢ xk
opaque symbol and_pos_aux (id : τ nat) (cnf: 𝕃 o) : π (id ∈ₙ (indexes cnf)) → π (¬ (conj cnf) ∨ (literal cnf id)) ≔
begin
  assume id cnf h;
  rewrite imp_eq_or;
  assume hconj;
  refine select id cnf h hconj 
end;

// Rule and_pos: ¬(𝜑1 ∧ … ∧ 𝜑𝑛), 𝜑𝑘
// (and_pos) ⊢ ¬ (x1 ∧ ... ∧ xn), xk ≡ (x1 ∧ ... ∧ xn) ⊢ xk
opaque symbol and_pos (k : τ nat) (cnf: 𝕃 o) : π (k ∈ₙ (indexes cnf)) → π̇ (¬ (conj cnf) ⟇ (literal cnf k) ⟇ ▩) ≔
begin
  assume k cnf h;
  simplify;
  rewrite or_identity_r;
  refine and_pos_aux k cnf h
end;

symbol negate: 𝕃 o → 𝕃 o;
rule negate □ ↪ □
with negate ($x ⸬ $xs) ↪ ¬ $x ⸬ negate $xs;

symbol disj : 𝕃 o → τ o;
rule disj ($l1 ⸬ $l) ↪ ($l1 ∨ disj $l)
with disj □ ↪ ⊥;

opaque symbol disj_head (l0 : τ o) (l : 𝕃 o) : 
    π (l0) → π (disj (l0 ⸬ l)) ≔
begin
    assume l0;
    induction
        {assume h1; simplify; rewrite or_identity_r;
        refine h1}   
        {assume x0 l1 h1 h2; 
        refine ∨ᵢ₁ h2}
end; 

opaque symbol disj_tail (l0 : τ o) (l : 𝕃 o) : 
    π (disj l) → π (disj (l0 ⸬ l)) ≔
begin
    assume l0;
    induction
        {assume h1;
        refine ⊥ₑ h1}
        {assume x1 l1 h1 h2;
        refine ∨ᵢ₂ h2}
end;

opaque symbol disj_correct (l0 : τ o) (l : 𝕃 o) : 
    π (disj (l0 ⸬ l)) → π (l0 ∨ disj l) ≔
begin
    assume l0;
    induction
        {
          assume h1;
          refine h1
        }
        {assume x1 l1 h1 h2;
        refine h2}
end;

opaque symbol disj_complete (l0 : τ o) (l : 𝕃 o) : 
    π (l0 ∨ disj l) → π (disj (l0 ⸬ l))  ≔
begin
    assume l0;
    induction
        {
          refine (λ x, x)
        }
        {assume x1 l1 h1 h2;
        refine h2}
end;

opaque symbol disj_eq (l0 : τ o) (l : 𝕃 o) :  π ((l0 ∨ disj l) = disj (l0 ⸬ l)) ≔
begin
  assume x l;
  apply prop_ext;
  apply ∧ᵢ 
  { refine disj_complete x l }
  { refine disj_correct x l }
end;

opaque symbol conj_correct (c0 : τ o) (c : 𝕃 o) : 
    π (conj (c0 ⸬ c)) → π (c0 ∧ conj c) ≔
begin
    assume c0;
    induction
        {assume h1;
        refine ∧ᵢ h1 ⊤ᵢ}
        {assume x1 c1 h1 h2;
        refine h2}
end;

opaque symbol conj_complete (c0 : τ o) (c : 𝕃 o) : 
     π (c0 ∧ conj c) → π (conj (c0 ⸬ c)) ≔
begin
    assume c0;
    induction
        {assume h1; simplify;
        refine ∧ₑ₁ h1}
        {assume x1 c1 h1 h2;
        refine h2}
end;

opaque symbol conj_eq (l0 : τ o) (l : 𝕃 o) :  π ((l0 ∧ conj l) = conj (l0 ⸬ l)) ≔
begin
  assume x l;
  apply prop_ext;
  apply ∧ᵢ 
  { refine conj_complete x l }
  { refine conj_correct x l }
end;
 
opaque symbol morgan (l: 𝕃 o) : π ((¬ (disj l)) = conj (negate l)) ≔
begin
induction
{
  simplify;
  apply prop_ext;
  apply ∧ᵢ { assume h; apply ⊤ᵢ } { assume h; refine (λ x, x) }
}
{
  assume h tl IH;
  rewrite left disj_eq;
  rewrite morgan2;
  rewrite IH;
  simplify;
  rewrite conj_eq;
  reflexivity
}
end;

opaque symbol morganN2 (l: 𝕃 o) : π ((¬ (conj l)) = disj (negate l)) ≔
begin
induction
{
  simplify;
  apply prop_ext;
  apply ∧ᵢ { assume h; apply h ⊤ᵢ } { assume h; apply ⊥ₑ h }
}
{
  assume h tl IH;
  simplify;
  rewrite left conj_eq;
  rewrite left IH;
  have foldneg: Π e, π (¬ e = (e ⇒ ⊥)) { reflexivity };
  rewrite left foldneg;
  rewrite morgan1 h (conj tl);
  reflexivity
}
end;

opaque symbol clause_to_disj_from_list l : π (⟇_to_∨_rw (list_to_clause l) = disj l) ≔
begin
induction
{reflexivity}
{
  assume x xs ih;simplify;
  apply feq2 (∨) _ _
  {reflexivity}
  {refine ih}  
}
end;

opaque symbol select_disj (id : τ nat) (l: 𝕃 o) : 
    π (id ∈ₙ (indexes (negate l))) → π (¬ (disj l)) → π (literal (negate l) id) ≔
begin
  assume id l H Hdisj;
  have g: π (conj (negate l)) { rewrite left morgan l; refine Hdisj };
  refine select id (negate l) H g;
end;

// Rule not_or:
// i. ▷ ¬(𝜑1 ∨ ⋯ ∨ 𝜑𝑛)
// j. ▷ ¬𝜑𝑘
opaque symbol not_or (id : τ nat) (l: 𝕃 o) : 
    π (id ∈ₙ (indexes (negate l))) → π (¬ (disj l)) → π̇ (literal (negate l) id ⟇  ▩) ≔
begin
  assume id l H Hdisj;
  apply ∨ᵢ₁;
  have g: π (conj (negate l)) { rewrite left morgan l; refine Hdisj };
  refine select id (negate l) H g;
end;


opaque symbol not_and_aux (l: 𝕃 o) : 
    π (¬ (conj l)) → π (disj (negate l)) ≔
begin
  induction
  { assume H; refine H ⊤ᵢ }
  {
    assume x xs IH Hconj;
    simplify;
    have g: π (¬ (x ∧  conj xs)) {
      rewrite conj_eq;
      refine Hconj;
    };
    have g2: π (¬ x ∨  ¬ conj xs) { rewrite left morgan1; refine g };
    apply ∨ₑ g2 
    { assume Hnx; apply ∨ᵢ₁; refine Hnx; }
    { assume Hnxs; apply ∨ᵢ₂; refine IH Hnxs }
  }
end;

// i. ▷ ¬(𝜑1 ∧ … ∧ 𝜑𝑛)
// j. ▷ ¬𝜑1, … , ¬𝜑𝑛
opaque symbol not_and (l: 𝕃 o) : 
    π (¬ (conj l)) → π̇ (list_to_clause (negate l)) ≔
begin
  simplify;
  assume l h;
  rewrite clause_to_disj_from_list (negate l);
  refine not_and_aux l h;
end;

// assert c0 c1 c2 c2' ⊢ not_and_k (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □): 
//     π (¬ (c0 ∧ c1 ∧ c2 ∧ c1)) → π ((¬ c0) ∨ (¬ c1) ∨ (¬ c2) ∨ (¬ c1));

// or_pos: ⊢ ¬ (x1 ∨ ... ∨ xn) ∨ x1 ∨ ... ∨ xn
opaque symbol or_pos_aux (l: 𝕃 o) : π (¬ (disj l) ∨ (disj l)) ≔
begin
  assume l;
  rewrite ∨_com;
  apply em
end;


// Rule or_pos:  ¬(𝜑1 ∨ ⋯ ∨ 𝜑𝑛), 𝜑1 , … , 𝜑𝑛
opaque symbol or_pos (l: 𝕃 o) :  π̇ ((¬ (disj l)) ⟇ (list_to_clause l)) ≔
begin
  assume l;
  simplify;
  rewrite clause_to_disj_from_list;
  rewrite ∨_com;
  apply em
end;

// and_neg: ⊢  (x1 ∧ ... ∧ xn) ∨ ¬ x1 ∨ ... ∨ ¬ xn
opaque symbol and_neg_aux (l: 𝕃 o) : π ((conj l) ∨ disj (negate l)) ≔
begin
  assume l;
  rewrite left morganN2 l;
  refine em (conj l);
end;

symbol cl_to_list : Clause → 𝕃 o;
 rule cl_to_list ($p ⟇ $ps) ↪ $p ⸬ (cl_to_list $ps)
with cl_to_list ▩ ↪ □;

symbol clause_to_disj_via_list c: π (⟇_to_∨_rw c = disj (cl_to_list c)) ≔
begin
  refine ind_ℂ (λ u, ⟇_to_∨_rw u = disj (cl_to_list u)) _ _ 
  {reflexivity}
  {
    assume x xs ih;
    refine feq2 (∨) _ _
    {reflexivity}
    {refine ih};
  }
end;

// and_neg:  (𝜑1 ∧ ⋯ ∧ 𝜑𝑛), ¬𝜑1, … , ¬𝜑𝑛
opaque symbol and_neg [c] (l: 𝕃 o) : π (disj (cl_to_list c) = disj (negate l)) → π̇ ((conj l) ⟇ c) ≔
begin
  assume c l h;
  simplify;
  rewrite clause_to_disj_via_list;
  rewrite h;
  refine and_neg_aux l
end;


opaque symbol lit_imp_disj (c: 𝕃 o) (ks: 𝕃 nat) : 
    π (`∃ x, literal c x ∧ x ∈ₙ ks) → π (disj (literals c ks)) ≔
begin
    assume c;
    induction
    {assume h1;
        have H0: Π x: τ nat, π ((λ x1, literal c x1 ∧ ⊥) x) → π ⊥
        {assume x h2;
        refine ∧ₑ₂ h2};
        refine ∃ₑ h1 H0}
    {assume n l h1 h2;
        have H1: Π x: τ nat,
        π ((λ x1, literal c x1 ∧ (eqn x1 n Stdlib.Bool.or x1 ∈ₙ l)) x)
            → π (disj (literal c n ⸬ literals c l))
        {assume m h3;
        have H0: π (eqn m n ∨ m ∈ₙ l)
            {refine ∨_istrue [eqn m n] [m ∈ₙ l] (∧ₑ₂ h3)};
        have H1: π (eqn m n) → π (disj (literal c n ⸬ literals c l))
            {assume h4;
            have H1_0: π (literal c n)
                {have H1_0_0: π (n = m)
                {symmetry;
                refine eqn_correct m n h4};
                rewrite H1_0_0;
                refine ∧ₑ₁ h3};
            refine disj_head (literal c n) (literals c l) H1_0};
        have H2: π (m ∈ₙ l) → π (disj (literal c n ⸬ literals c l))
            {assume h4;
            have H2_0: π (`∃ x, literal c x ∧ x ∈ₙ l)
                {have H2_0_0: π ((λ x, literal c x ∧ x ∈ₙ l) m)
                {refine ∧ᵢ (∧ₑ₁ h3) h4};
                refine ∃ᵢ m H2_0_0};
            refine disj_tail (literal c n) (literals c l) (h1 H2_0)};
        refine ∨ₑ H0 H1 H2};
        refine ∃ₑ h2 H1}
end;

assert c0 c1 c2 c2' ⊢ lit_imp_disj (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □) (indexes (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □)): 
    π (`∃ x, literal (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □) x ∧ x ∈ₙ (indexes (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □))) → π (disj (literals (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □) (indexes (c0 ⸬ c1 ⸬ c2 ⸬ c1 ⸬ □))));


// or_neg  (x1 ∨ ... ∨ xn) ∨ ¬ xk ≡ ¬ xk ∨ (x1 ∨ ... ∨ xn) ≡  xk ⇒ (x1 ∨ ... ∨ xn) ≡ xk ⊢  (x1 ∨ ... ∨ xn)
opaque symbol or_neg_aux id (l: 𝕃 o) : 
    π (literal l id ∧ id ∈ₙ (indexes l)) → π (disj l) ≔
begin
  assume id l h;
  have g: π (disj (literals l (indexes l)))
  {
    refine lit_imp_disj l (indexes l) _;
    refine ∃ᵢ id _;
    refine h
  };
  rewrite left nths_indexes_id ⊥ l;
  refine g
end;

// Rule or_neg (𝜑1 ∨ … ∨ 𝜑𝑛), ¬𝜑
// However, this lemma prove ¬𝜑, (𝜑1 ∨ … ∨ 𝜑𝑛)
// The litteral ¬𝜑
opaque symbol or_neg [c] k (l: 𝕃 o) : π ((disj (cl_to_list c)) = (disj l)) →
    π (k ∈ₙ (indexes l)) → π̇ ((¬ (literal l k )) ⟇ c) ≔
begin
  assume c k l h h2;
  simplify;
  // rewrite ∨_com;
  rewrite clause_to_disj_via_list;
  rewrite h;
  change π ((¬ nth ⊥ l k) ∨ disj l);
  rewrite imp_eq_or;
  assume hlit;
  refine or_neg_aux k l _ ;
  apply ∧ᵢ
  { refine hlit }
  { refine h2 }
end;

symbol sym_clause x y : π̇ (x ⟇ y ⟇ ▩) → π̇ (y ⟇ x ⟇ ▩) ≔
begin
simplify;
assume x y h;
rewrite left  ∨_assoc;
rewrite ∨_com y x;
rewrite ∨_assoc;
refine h
end;

symbol eraseIdx [a] : 𝕃 a → ℕ → 𝕃 a;
rule eraseIdx □ _ ↪ □
with eraseIdx (_ ⸬ $xs) 0 ↪ $xs
with eraseIdx ($x ⸬ $xs) ($n +1) ↪ $x ⸬ (eraseIdx $xs $n);

assert ⊢ (eraseIdx (0 ⸬ 1 ⸬ 2 ⸬ 3 ⸬ □) 2) ≡ (0 ⸬ 1 ⸬ 3 ⸬ □);
assert ⊢ (eraseIdx (0 ⸬ 1 ⸬ 2 ⸬ 3 ⸬ □) 5) ≡ (0 ⸬ 1 ⸬ 2 ⸬ 3 ⸬ □);
assert ⊢ (eraseIdx  □ 2) ≡ □;

opaque symbol case_l [a] x (l: 𝕃 a) n : π ((n +1) ≤ (size (x ⸬ l))) → π (n ≤ (size l)) ≔
begin
  assume a x l n H;
  refine H
end;

symbol orN_eraseIdx qs j (hj: π (j < size qs)) : π ((disj (eraseIdx qs j) ∨ (nth ⊥ qs j)) = (disj qs)) ≔
begin
  induction
  {
    assume j;
    simplify;
    assume contra;
    refine ⊥ₑ contra
  }
  {
    assume t l ih;
    induction
    {
      simplify;
      assume h;
      rewrite ∨_com;
      reflexivity
    }
   {
      assume j ih2 h; print <;
      simplify;
      rewrite left ih j (case_l t l (j +1) h);
      remove ih2;
      rewrite left ∨_assoc;
      reflexivity
    }
  }
end;

print ind_ℕ;

symbol rec_ℕ : Π p0: (ℕ → Prop), π (p0 0) → (Π x0: ℕ, π (p0 (x0 +1))) → Π x: ℕ, π (p0 x);

symbol sublist [a] (xs : 𝕃 a) (i j : ℕ) ≔ drop i (take j xs);

symbol orN_subList (qs ps : 𝕃 o)  (i j : ℕ) (hps : π (disj ps)) (hpq : π (ps = sublist qs i j)) : π (disj qs) ≔
begin
  induction // qs
  {
    assume x i j h1 heq;
    change π (disj (sublist □ i j));
    rewrite left heq;
    apply h1    
  }
  {
    assume t l ih;
    assume  ps i;
    refine rec_ℕ (λ j, disj ps ⇒ ((ps = sublist (t ⸬ l) i j) ⇒ disj (t ⸬ l))) _ _
    {
      simplify;
      assume hp hps;
      apply ∨ᵢ₂;
      refine ih ps i 0 hp hps;
    }
    {
      assume j;
      generalize i;
      refine rec_ℕ (λ i, `∀ j, disj ps ⇒ ((ps = sublist (t ⸬ l) i (j +1)) ⇒ disj (t ⸬ l))) _ _
      {
        simplify;
        assume j hps heq;
        type ih ps 0 j hps;
        compute sublist l 0 j;
        have g: π (t ∨ disj (take j l)) {
          change π (disj (t ⸬ take j l));
          rewrite left heq;
          apply hps
        };
        apply ∨ₑ g
        { assume ht; apply ∨ᵢ₁; refine ht }
        { assume g2; apply ∨ᵢ₂; apply ih (drop 0 (take j l)) 0 j g2 (eq_refl _) }
      }
      {
        simplify;
        assume i j hp hps;
        apply ∨ᵢ₂;
        apply ih ps i j hp hps;
      }
    }
  }
end;

symbol orN_append_right (ps qs : 𝕃 o) (hqs : π (disj qs)) : π (disj (ps Stdlib.List.++ qs)) ≔
begin
  assume ps qs hqs;
  apply orN_subList (ps Stdlib.List.++ qs) qs  (size ps) (size ps + size qs) hqs;
  simplify;
  rewrite left size_cat;
  rewrite take_size;
  rewrite drop_size_cat (size ps) ps qs (eq_refl _);
  reflexivity
end;

symbol orN_append_left (ps qs : 𝕃 o) (hqs : π (disj ps)) : π (disj (ps Stdlib.List.++ qs)) ≔
begin
  assume ps qs hps;
  apply orN_subList (ps Stdlib.List.++ qs) ps  0 (size ps) hps;
  simplify;
  rewrite take_size_cat (size ps) ps qs (eq_refl _);
  reflexivity
end;

// Used when carcara put the flag at `false`
symbol disj_resolutionN1 (ps qs:  𝕃 o) (i j: ℕ)
  (hps: π (disj ps))
  (hqs: π (disj qs))
  (hi: π (i < size ps))
  (hj: π (j < size qs))
  (hij: π ((nth ⊥ ps i) = ¬ (nth ⊥ qs j))) : π (disj ((eraseIdx ps i) Stdlib.List.++ (eraseIdx qs j))) ≔
begin
assume ps qs i j;
have h: π ((nth ⊥ ps i) ∨ ¬ (nth ⊥ ps i)) { refine em (nth ⊥ ps i) };
assume hps hqs hi hj hij;
have h1: π ((disj (eraseIdx ps i) ∨ nth ⊥ ps i) = disj ps) { refine  orN_eraseIdx ps i hi };
have h2: π ((disj (eraseIdx qs j) ∨ nth ⊥ qs j) = disj qs) { refine orN_eraseIdx qs j hj };
apply ∨ₑ h
{
  assume hp;
  have hij': π (nth ⊥ ps i ⇔ ¬ (nth ⊥ qs j)) { rewrite hij; apply ⇔_refl };
  have h3: π (¬ (nth ⊥ qs j)) { refine ∧ₑ₁ hij' hp };
  have hps': π ((disj (eraseIdx ps i) ∨ ¬ (nth ⊥ qs j))) { rewrite left hij; apply ∨ᵢ₂; refine hp };
  remove hps;
  remove h1;
  have hqs': π ((disj (eraseIdx qs j) ∨ nth ⊥ qs j)) { rewrite h2; apply hqs };
  remove h2;
  remove hqs;
  have g: π ((⊥ = nth ⊥ qs j)) { rewrite ⊥= (nth ⊥ qs j); refine h3 };
  have hqs'': π (disj (eraseIdx qs j)) { rewrite left or_identity_r; rewrite g; refine hqs' };
  apply orN_append_right (eraseIdx ps i) (eraseIdx qs j) hqs'';
}
{
  assume hp;
   have g: π ((⊥ = nth ⊥ ps i)) { rewrite ⊥= (nth ⊥ ps i); refine hp };
   have hps': π ((disj (eraseIdx ps i))) { rewrite left or_identity_r; rewrite g;  rewrite h1; apply hps };
   have hqs': π ((disj (eraseIdx qs j) ∨ nth ⊥ qs j)) { rewrite h2; apply hqs };
  apply orN_append_left (eraseIdx ps i) (eraseIdx qs j) hps';
}
end;

// Used when carcara put the flag at `true`
symbol disj_resolutionN2 (ps qs:  𝕃 o) (i j: ℕ)
  (hps: π (disj ps))
  (hqs: π (disj qs))
  (hi: π (i < size ps))
  (hj: π (j < size qs))
  (hij: π (¬ (nth ⊥ ps i) = (nth ⊥ qs j))) : π (disj ((eraseIdx ps i) Stdlib.List.++ (eraseIdx qs j))) ≔
begin
admit
end;

// Lemmas `cl_⭈_cl` and `disj_⭈_cl` are used to prove the iso:  π̇ c ≡ π (disj l) with the invariant (⟇_to_∨_rw c = disj l).
// We need this lemma to use disj_resolutionN from π̇ c

opaque symbol cl_⭈_cl c l: π̇ c → π (⟇_to_∨_rw c = disj l) → π (disj l) ≔
begin
  simplify;
  change  Π c: Clause,  π (`∀ l: 𝕃 o, ⟇_to_∨_rw c ⇒ ⟇_to_∨_rw c = disj l ⇒ disj l);
  refine ind_ℂ (λ u, `∀ l, ⟇_to_∨_rw u ⇒ ((⟇_to_∨_rw u = disj l) ⇒ disj l)) _ _
  { simplify; assume l h heq; rewrite left heq; refine h  }
  { assume c cs ih; induction
    { simplify; assume h heq; rewrite left heq; apply h }
    { assume l ls ih2 h1 h2; rewrite left h2; apply h1 }
  };
end;

symbol disj_⭈_cl l c: π (disj l) → π (disj l = ⟇_to_∨_rw c) → π̇ c ≔
begin
  simplify;
  induction
  {simplify; assume x Hcontra; apply ⊥ₑ Hcontra}
  {
    assume l ls ihl;
    refine ind_ℂ (λ u, disj (l ⸬ ls) ⇒ ((disj (l ⸬ ls) = ⟇_to_∨_rw u) ⇒ ⟇_to_∨_rw u)) _ _
    { simplify; assume h heq; rewrite left heq; apply h }
    {assume x xs ih2 h1 h2; rewrite left h2; apply h1 }
  }
end;

symbol cl↪list : Clause → 𝕃 o;
rule cl↪list ▩ ↪ □
with cl↪list ($x ⟇ $xs) ↪ $x ⸬ (cl↪list $xs);

symbol list↪cl :  𝕃 o → Clause;
rule list↪cl □ ↪ ▩
with list↪cl ($x ⸬ $xs) ↪ $x ⟇ (list↪cl $xs);

coerce_rule coerce Clause (𝕃 o) $x ↪ cl↪list $x;
coerce_rule coerce (𝕃 o) Clause  $x ↪ list↪cl $x;

symbol ∨ₑₙ (l : 𝕃 o) : π̇ ((disj l) ⟇ ▩) → π̇ (cl_to_list l) ≔
begin
simplify;
induction
{simplify; assume h; apply ∨ₑ h { refine λ x, x } { refine λ x, x }}
{
  simplify;
  assume x xs ih;
  change π ((x ∨ disj xs) ∨ ⊥ ⇒ x ∨ ⟇_to_∨_rw (list↪cl (cl_to_list (list↪cl xs))));
  rewrite or_identity_r;
  assume h;
  apply ∨ₑ h
  { assume hx; apply ∨ᵢ₁; refine hx }
  { assume hxs; apply ∨ᵢ₂; apply ih; apply ∨ᵢ₁; refine hxs}
}
end;