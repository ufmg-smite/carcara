// not_and:
// i. ▷ ¬(𝜑1 ∧ … ∧ 𝜑𝑛)
// j. ▷ ¬𝜑1, … , ¬𝜑𝑛
// sequential symbol not_and_r: Prop → Clause → 𝔹;
// rule not_and_r ($x ∧ $tl) (($x ⇒ ⊥) ⟇ $tl2) ↪ not_and_r $tl $tl2
// with not_and_r ⊤ ▩ ↪ true;

// sequential symbol not_and_r': Prop → Clause → 𝔹;
// rule not_and_r' ($x ∧ $tl) (($x ⇒ ⊥) ⟇ $tl2) ↪ not_and_r' $tl $tl2
// with not_and_r' $x (($x ⇒ ⊥) ⟇ ▩) ↪ true;

