// and:
// i. ▷ (𝜑1 ∧ ⋯ ∧ 𝜑𝑛)
// j. ▷ 𝜑𝑘
symbol and [φₖ] φ₁__φₙ : π ((In_∧' φₖ φ₁__φₙ) = true) → π̇ (φ₁__φₙ ⟇ ▩)  → π̇ (φₖ ⟇ ▩);

opaque symbol test_and:  π̇ ((a ∧ b ∧ c ∧ d) ⟇ ▩) →  π̇ (c ⟇ ▩) ≔
begin
  assume t1;
  apply and ((a ∧ b ∧ (c ∧ d))) { simplify; reflexivity } { apply t1  };
end;

opaque symbol resolutionₗ x a b: π̇ (x ⟇ a) → π̇ ((¬ x) ⟇ b) → π̇ (a ++ b) ≔ begin
  assume x a b H1 H2;
  apply ⟇ₑ H1 {
    assume Hx;
    apply ⟇ₑ H2 {
      assume Hnx;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b)  ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ₑ Hx { assume Hpi_x;  apply ∨ₑ Hnx { assume Hpi_nx;  apply ¬ₑ Hpi_nx Hpi_x }  {  assume Hbot; apply ⊥ₑ;  apply Hbot  } } { assume Hbot; apply ⊥ₑ;  apply Hbot  };
    } {
      assume Hb;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b)  ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ᵢ₂;
      apply Hb;
    }
  } {
    assume Ha;
    apply ⟇ₑ H2 {
      assume Hnx;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ᵢ₁;
      apply Ha
    } {
      assume Hb;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply   tmp;
      apply ∨ᵢ₁;
      apply Ha
    }
  };
end;

opaque symbol resolutionᵣ x a b: π̇ ((¬ x) ⟇ a) → π̇ (x ⟇ b) → π̇ (a ++ b) ≔ begin
  assume x a b H1 H2;
  apply ⟇ₑ H1 {
    assume Hnx;
    apply ⟇ₑ H2 {
      assume Hx;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ₑ Hx { assume Hpi_x;  apply ∨ₑ Hnx { assume Hpi_nx;  apply ¬ₑ Hpi_nx Hpi_x }  {  assume Hbot; apply ⊥ₑ;  apply Hbot  } } { assume Hbot; apply ⊥ₑ;  apply Hbot  };
    } {
      assume Hb;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b)  ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ᵢ₂;
      apply Hb;
    }
  } {
    assume Ha;
    apply ⟇ₑ H2 {
      assume Hnx;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ᵢ₁;
      apply Ha
    } {
      assume Hb;
      have tmp:  π ((⟇_to_∨_rw a ∨ ⟇_to_∨_rw b) ⇒ ⟇_to_∨_rw (a ++ b)) {
        apply ∧ₑ₂ (++_to_∨ a b);
      };
      apply  tmp;
      apply ∨ᵢ₁;
      apply Ha
    }
  };
end;

opaque symbol bind_∃ [a p q]: (Π x, π (p x = q x))  → π ((`∃ (x: τ a), p x) = (`∃ (x: τ a), q x)) ≔
begin
  assume a p q H;
  apply prop_ext;
  apply ∧ᵢ
  {
    
    assume H1;
    apply ∃ₑ H1;
    assume x Hpx;
    apply ∃ᵢ x;
    simplify;
    rewrite left (H x);
    apply Hpx;
  }
  {
    
    assume H1;
    apply ∃ₑ H1;
    assume x Hqx;
    apply ∃ᵢ x;
    simplify;
    rewrite (H x);
    apply Hqx;
  };
end;

opaque symbol bind_∀ [a p q]: (Π (x: τ a), π (p x = q x))  → π ((`∀ (x: τ a), p x) = (`∀ (x: τ a), q x)) ≔
begin
  assume a p q H;
  apply prop_ext;
  apply ∧ᵢ
  {
    
    assume H1;
    assume x;
    have Hpx: π (p x) { apply H1; };
    rewrite left (H x);
    apply Hpx;
  }
  {
    
    assume H1;
    assume x;
    have Hqx: π (q x) { apply H1 };
    rewrite (H x);
    apply Hqx;
  };
end;

opaque symbol bind_∀' [a p q]: (Π (x: τ a), Π (y: τ a), π (x = y) → π (p x = q y))  → π ((`∀ (x: τ a), p x) = (`∀ (y: τ a), q y)) ≔
begin
  assume a p q;
  assume H;
  apply prop_ext;
  apply ∧ᵢ
  {
    
    assume H1;
    assume x;
    have Hpx: π (p x) { apply H1; };
    rewrite left H x x (eq_refl x);
    apply Hpx
  }
  {
    
    assume H1;
    assume x;
    have Hqx: π (q x) { apply H1 };
    rewrite H x x (eq_refl x);
    apply Hqx;
  };
end;

opaque symbol sko_forall [a p q]: (Π (x: τ a), π (x = `ϵ (y: τ a), ¬ (p y)) → π (p x = q))  → π ((`∀ (x: τ a), p x) = q) ≔
begin
  assume a p q H;
  apply prop_ext;
  apply ∧ᵢ
  {
    refine  (∧ₑ₂ (@contrapos (`∀ x, p x) q)) _;
    assume Hnq;
    rewrite .[x in ¬ x]  (ϵ_to_∀ p);
    have H1:  π (p (`ϵ x, ¬ (p x)) = q) { apply H; reflexivity };
    rewrite H1;
    refine Hnq
  }
  {
    rewrite .[x in _ ⇒ x]  (ϵ_to_∀ p);
    
    assume Hq;
    have H1:  π (p (`ϵ y, ¬ (p y)) = q) { apply H; reflexivity };
    rewrite H1;
    apply Hq
  }
end;

// Inductive t A : nat -> Type :=
//   |nil : t A 0
//   |cons : forall (h:A) (n:nat), t A n -> t A (S n).
(a: Set) inductive Vec: ℕ → TYPE ≔
| ⧈ : Vec a 0 // \Box
| cons [n: ℕ] : τ a →  Vec a n  →  Vec a (n + 1);

print Vec;

constant symbol vec : Set → ℕ → Set;
rule τ (vec $a $n) ↪ Vec $a $n;

symbol distinct [a] [n: τ nat]  : Vec a n → Prop;

// // boolean case
rule distinct (cons _ ⧈) ↪ ⊤
with distinct (cons $x (cons $y ⧈)) ↪ ($x ≠ $y)
with distinct ⧈ ↪ ⊥
with distinct (cons _ (cons _ (cons _ _))) ↪ ⊥;


// 
assert ⊢ distinct (cons a ⧈) ≡ ⊤;
assert ⊢ distinct ((cons a (cons b ⧈))) ≡ (a ≠ b);
assert ⊢ distinct (cons a (cons b (cons c ⧈))) ≡ ⊥;
assert ⊢ distinct (cons a (cons b (cons c (cons d ⧈)))) ≡ ⊥;


assert ⊢ distinct (cons 1 ⧈) ≡ ⊤;
assert ⊢ distinct ((cons 1 (cons 2 ⧈))) ≡ (1 ≠ 2);
assert ⊢ distinct (cons 1 (cons 2 (cons 3 ⧈))) ≡ ⊥;

opaque symbol distinct_elim  [a] [t: τ a] : π (distinct (cons t ⧈) = ⊤) ≔ eq_refl (distinct(cons t ⧈));

opaque symbol distinct_elim₂ [a] [x y: τ a] : π ((distinct ((cons x (cons y ⧈)))) = (x ≠ y)) ≔ eq_refl (distinct (cons x (cons y ⧈)));

//opaque symbol distinct_elim₃ [a] [n: τ nat] [v: Vec a (n + 3)] : π (distinct v = ⊥) ≔  eq_refl (distinct v);

opaque symbol feq [a b] (f:τ a → τ b) [x x':τ a] : π(x = x') → π(f x = f x') ≔
begin
  assume a b f x x' xx'; rewrite xx'; reflexivity;
end;

opaque symbol feq2 [a b c] (f:τ a → τ b → τ c):
  Π [x x':τ a], π(x = x') → Π [y y':τ b], π(y = y') → π(f x y = f x' y') ≔
begin
  assume a b c f x x' xx' y y' yy'; rewrite xx'; rewrite yy'; reflexivity
end;

opaque symbol feq3 [a b c d] (f:τ a → τ b →  τ c → τ d):
  Π [x x':τ a], π(x = x') → Π [y y':τ b], π(y = y') → Π [z z':τ c], π(z = z') → π(f x y z = f x' y' z') ≔
begin
  assume a b c d f x x' xx' y y' yy' z z' zz'; rewrite xx'; rewrite yy'; rewrite zz'; reflexivity
end;

opaque symbol feq4 [a b c d e] (f:τ a → τ b →  τ c → τ d → τ e):
  Π [x1 x1':τ a], π(x1 = x1') →
  Π [x2 x2':τ b], π(x2 = x2') →
  Π [x3 x3':τ c], π(x3 = x3') →
  Π [x4 x4':τ d], π(x4 = x4') →
  π(f x1 x2 x3 x4 = f x1' x2' x3' x4') ≔
begin
  assume a b c d e f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  reflexivity
end;

opaque symbol feq5 [a b c d e g] (f:τ a → τ b →  τ c  → τ d → τ e → τ g ):
  Π [x1 x1':τ a], π(x1 = x1') →
  Π [x2 x2':τ b], π(x2 = x2') →
  Π [x3 x3':τ c], π(x3 = x3') →
  Π [x4 x4':τ d], π(x4 = x4') →
  Π [x5 x5':τ e], π(x5 = x5') →
  π(f x1 x2 x3 x4 x5 = f x1' x2' x3' x4' x5') ≔
begin
  assume a b c d e g f;
  assume x1 x1' H1;
  assume x2 x2' H2;
  assume x3 x3' H3;
  assume x4 x4' H4;
  assume x5 x5' H5;
  rewrite H1;
  rewrite H2;
  rewrite H3;
  rewrite H4;
  rewrite H5;
  reflexivity
end;

builtin "bot" ≔ ⊥;
builtin "top" ≔ ⊤;
builtin "imp" ≔ ⇒;
builtin "and" ≔ ∧;
builtin "or"  ≔ ∨;
builtin "not" ≔ ¬;
builtin "eqv"  ≔ ⇔;

opaque symbol cong_or [t1 t2 u1 u2: τ o]: π̇ (t1 = u1 ⟇ ▩) → π̇ (t2 = u2 ⟇ ▩) → π̇ ((t1 ∨ t2) = (u1 ∨ u2) ⟇ ▩) ≔
begin
  assume t1 t2 u1 u2 H1 H2;
  have H1': π (t1 = u1) { apply π̇ₗ H1 };
  have H2': π (t2 = u2) { apply π̇ₗ H2 };
  apply ∨ᵢ₁;
  rewrite H1';
  rewrite H2';
   reflexivity
end;

opaque symbol cong_and [t1 t2 u1 u2: τ o]: π̇ (t1 = u1 ⟇ ▩) → π̇ (t2 = u2 ⟇ ▩) → π̇ ((t1 ∧ t2) = (u1 ∧ u2) ⟇ ▩) ≔
begin
  assume t1 t2 u1 u2 H1 H2;
  have H1': π (t1 = u1) { apply π̇ₗ H1 };
  have H2': π (t2 = u2) { apply π̇ₗ H2 };
  apply ∨ᵢ₁;
  rewrite H1';
  rewrite H2';
   reflexivity
end;

opaque symbol cong_imp [t1 t2 u1 u2: τ o]: π̇ (t1 = u1 ⟇ ▩) → π̇ (t2 = u2 ⟇ ▩) → π̇ ((t1 ⇒ t2) = (u1 ⇒ u2) ⟇ ▩) ≔
begin
  assume t1 t2 u1 u2 H1 H2;
  have H1': π (t1 = u1) { apply π̇ₗ H1 };
  have H2': π (t2 = u2) { apply π̇ₗ H2 };
  apply ∨ᵢ₁;
  rewrite H1';
  rewrite H2';
   reflexivity
end;

