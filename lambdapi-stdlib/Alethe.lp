opaque symbol subst_equiv_clause : Π x: Clause, Π y: Clause, π (⟇_to_∨_rw x = ⟇_to_∨_rw y) → π̇ x → π̇ y ≔
begin
assume x y;
simplify;
assume Heq; assume Hx;
rewrite left Heq;
apply Hx
end;

