(assume h1 (= a 5))
(anchor :step t1 :args ((a Int)))
(step t1.t1 (cl (= a 5)) :rule weakening :premises (h1))
(step t1 (cl (= (let ((a 0)) a) (let ((a 0)) 5))) :rule bind_let)
(anchor :step t2 :args ((:= (a Int) 0)))
(step t2.t1 (cl (= a 0)) :rule refl)
(step t2 (cl (= (let ((a 0)) a) 0)) :rule let)
(anchor :step t3 :args ((:= (a Int) 0)))
(step t3.t1 (cl (= 5 5)) :rule refl)
(step t3 (cl (= (let ((a 0)) 5) 5)) :rule let)
(step t4 (cl (= 0 (let ((a 0)) a))) :rule symm :premises (t2))
(step t5 (cl (= 0 5)) :rule trans :premises (t4 t1 t3))
(step t6 (cl (= (= 0 5) false)) :rule eq_simplify)
(step t7 (cl (not (= (= 0 5) false)) (not (= 0 5)) false) :rule equiv_pos2)
(step t8 (cl (not false)) :rule false)
(step t9 (cl) :rule resolution :premises (t5 t6 t7 t8))
