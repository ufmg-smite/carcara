(define-fun kD () String (choice ((x String)) (exists ((k_0 String) (R_0 RegLan) (R_1 RegLan)) (and (= z (str.++ k_0 x)) (str.in_re k_0 R_0) (str.in_re x R_1)))))
(define-fun kB () String (choice ((x String)) (exists ((R_0 RegLan) (R_1 RegLan)) (and (= z (str.++ x kD)) (str.in_re x R_0) (str.in_re kD R_1)))))
(define-fun kD2 () String (choice ((x String)) (exists ((k_0 String) (R_0 RegLan) (R_1 RegLan)) (and (= kB (str.++ k_0 x)) (str.in_re k_0 R_0) (str.in_re x R_1)))))
(define-fun kB2 () String (choice ((x String)) (exists ((R_0 RegLan) (R_1 RegLan)) (and (= kB (str.++ x kD2)) (str.in_re x R_0) (str.in_re kD2 R_1)))))
(assume h1 (str.in_re z (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d")))))
(assume h2 (= z "abcd"))
(step s1 (cl (and (= z (str.++ kB kD)) (and (str.in_re kB (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d")))) (and (str.in_re kD (re.++ (str.to_re "c") (str.to_re "d"))) true)))) :rule re_concat_unfold_pos :premises (h1))
(step s2 (cl (= z (str.++ kB kD))) :rule and :premises (s1) :args (0))
(step s3 (cl (and (str.in_re kB (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d")))) (and (str.in_re kD (re.++ (str.to_re "c") (str.to_re "d"))) true))) :rule and :premises (s1) :args (1))
(step s4 (cl (str.in_re kB (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d"))))) :rule and :premises (s3) :args (0))
(step s5 (cl (and (str.in_re kD (re.++ (str.to_re "c") (str.to_re "d"))) true)) :rule and :premises (s3) :args (1))
(step s6 (cl (str.in_re kD (re.++ (str.to_re "c") (str.to_re "d")))) :rule and :premises (s5) :args (0))
(step s7 (cl (= kD (str.++ "c" "d"))) :rule re_concat_unfold_pos :premises (s6))
(step s8 (cl (and (= kB (str.++ kB2 kD2)) (and (str.in_re kB2 (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d")))) (and (str.in_re kD2 (re.++ (str.to_re "c") (str.to_re "d"))) true)))) :rule re_concat_unfold_pos :premises (s4))
(step s9 (cl (= kB (str.++ kB2 kD2))) :rule and :premises (s8) :args (0))
(step s10 (cl (and (str.in_re kB2 (re.++ (re.++ (str.to_re "a") (str.to_re "b")) (re.++ (str.to_re "c") (str.to_re "d")))) (and (str.in_re kD2 (re.++ (str.to_re "c") (str.to_re "d"))) true))) :rule and :premises (s8) :args (1))
(step s11 (cl (and (str.in_re kD2 (re.++ (str.to_re "c") (str.to_re "d"))) true)) :rule and :premises (s10) :args (1))
(step s12 (cl (str.in_re kD2 (re.++ (str.to_re "c") (str.to_re "d")))) :rule and :premises (s11) :args (0))
(step s13 (cl (= kD2 (str.++ "c" "d"))) :rule re_concat_unfold_pos :premises (s12))
(step s14 (cl (= (str.++ kB kD) (str.++ (str.++ kB2 kD2) (str.++ "c" "d")))) :rule cong :premises (s9 s7))
(step s15 (cl (= "abcd" z)) :rule symm :premises (h2))
(step s16 (cl (= "abcd" (str.++ (str.++ kB2 kD2) (str.++ "c" "d")))) :rule trans :premises (s15 s2 s14))
(step s17 (cl (= "ab" (str.++ kB2 kD2))) :rule concat_eq :premises (s16) :args (true))
(step s18 (cl (= (str.++ kB2 kD2) (str.++ kB2 (str.++ "c" "d")))) :rule cong :premises (s13))
(step s19 (cl (= "ab" (str.++ kB2 (str.++ "c" "d")))) :rule trans :premises (s17 s18))
(step s20 (cl false) :rule concat_conflict :premises (s19) :args (true))
(step s21 (cl (not false)) :rule false)
(step s22 (cl) :rule resolution :premises (s20 s21))
