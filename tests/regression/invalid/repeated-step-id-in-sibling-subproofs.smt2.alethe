(assume h1 a)
(assume h2 (not a))
(anchor :step t1)
(step s (cl a) :rule hole :premises (h1))
(step t1.t1 (cl a) :rule hole :premises (s))
(step t1 (cl a) :rule hole)
(anchor :step t2)
(step s (cl (not a)) :rule hole :premises (h2))
(step t2.t1 (cl (not a)) :rule hole :premises (s))
(step t2 (cl (not a)) :rule hole)
(step t3 (cl) :rule resolution :premises (t1 t2))
