(assume h1 (>= (* 1 x1) 1))
(assume h2 (>= (* 1 x2) 0))
(assume h3 (= x2 0))
(step t1 (cl (>= (+ (* 0 x1) (* 1 x2)) 1)) :rule cp_addition :premises (h1 h2))
(step t2 (cl (not (>= (+ (* 0 x1) (* 1 x2)) 1)) (not (= x2 0))) :rule la_generic :args (1 -1))
(step t3 (cl) :rule resolution :premises (h3 t1 t2))
