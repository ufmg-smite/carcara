(assume h1 (p (f x)))
(assume h2 (not (forall ((x Int)) (=> (= x x) (p x)))))
(anchor :step t3 :args ((:= (x Int) (f x))))
(step t3.t1 (cl (= (=> (= x x) (p x)) (=> (= (f x) (f x)) (p (f x))))) :rule refl)
(step t3.t2 (cl (= (= (f x) (f x)) true)) :rule eq_simplify)
(step t3.t3 (cl (= (=> (= (f x) (f x)) (p (f x))) (=> true (p (f x))))) :rule cong :premises (t3.t2))
(step t3.t4 (cl (= (=> true (p (f x))) (p (f x)))) :rule implies_simplify)
(step t3.t5 (cl (= (=> (= x x) (p x)) (p (f x)))) :rule trans :premises (t3.t1 t3.t3 t3.t4))
(step t3 (cl (= (forall ((x Int)) (=> (= x x) (p x))) (p (f x)))) :rule onepoint)
(step t4 (cl (forall ((x Int)) (=> (= x x) (p x))) (not (p (f x)))) :rule equiv2 :premises (t3))
(step t5 (cl) :rule resolution :premises (t4 h1 h2))
