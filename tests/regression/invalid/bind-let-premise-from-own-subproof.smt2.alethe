(assume h1 (not (= x 5)))
(anchor :step t2 :args ((:= (x Int) 5)))
(step t2.t1 (cl (= x 5)) :rule refl)
(step t2 (cl (= (let ((x x)) x) (let ((x x)) 5))) :rule bind_let)
(anchor :step t3 :args ((:= (x Int) x)))
(step t3.t1 (cl (= x x)) :rule refl)
(step t3 (cl (= (let ((x x)) x) x)) :rule let)
(anchor :step t4 :args ((:= (x Int) x)))
(step t4.t1 (cl (= 5 5)) :rule refl)
(step t4 (cl (= (let ((x x)) 5) 5)) :rule let)
(step t5 (cl (= x 5)) :rule trans :premises (t3 t2 t4))
(step t6 (cl) :rule resolution :premises (h1 t5) :args ((= x 5) false))
