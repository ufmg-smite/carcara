(assume h1 (= x 5))
(step c0 (cl true) :rule true)
(anchor :step t2 :args ((x Int)))
(anchor :step t2.t1 :args ((:= (y Int) 5)))
(step t2.t1.t1 (cl (= y 5)) :rule refl)
(step t2.t1 (cl (= (let ((y x)) y) 5)) :rule let :premises (h1))
(anchor :step t2.t2 :args ((:= (y Int) x)))
(step t2.t2.t1 (cl (= y x)) :rule refl)
(step t2.t2 (cl (= (let ((y x)) y) x)) :rule let)
(step t2.t3 (cl (= x (let ((y x)) y))) :rule symm :premises (t2.t2))
(step t2.t4 (cl (= x 5)) :rule trans :premises (t2.t3 t2.t1))
(step t2.t5 (cl (= (= x 5) true) (not (= x 5)) (not true)) :rule equiv_neg1)
(step t2.t6 (cl (= (= x 5) true)) :rule resolution :premises (t2.t5 t2.t4 c0))
(step t2 (cl (= (forall ((x Int)) (= x 5)) (forall ((x Int)) true))) :rule bind)
(step t3 (cl (= (forall ((x Int)) true) true)) :rule qnt_rm_unused)
(step t4 (cl (= (forall ((x Int)) (= x 5)) true)) :rule trans :premises (t2 t3))
(step t5a (cl (forall ((x Int)) (= x 5)) (not true)) :rule equiv2 :premises (t4))
(step t5 (cl (forall ((x Int)) (= x 5))) :rule resolution :premises (t5a c0))
(step t6a (cl (or (not (forall ((x Int)) (= x 5))) (= 1 5))) :rule forall_inst :args (1))
(step t6b (cl (not (forall ((x Int)) (= x 5))) (= 1 5)) :rule or :premises (t6a))
(step t6 (cl (= 1 5)) :rule resolution :premises (t6b t5))
(step t7 (cl (= (= 1 5) false)) :rule eq_simplify)
(step t8a (cl (not (= 1 5)) false) :rule equiv1 :premises (t7))
(step t8f (cl (not false)) :rule false)
(step t8 (cl) :rule resolution :premises (t8a t6 t8f))
