(assume h1 (= a 5))
(anchor :step t1 :args ((a Int) (:= (a Int) a)))
(step t1.t0 (cl (= a 5)) :rule weakening :premises (h1))
(step t1.t1 (cl (= (= (= a 5) true) (= a 5))) :rule equiv_simplify)
