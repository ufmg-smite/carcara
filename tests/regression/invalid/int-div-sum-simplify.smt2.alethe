(step t1 (cl (= (+ (div 1 2) (div 1 2)) 1)) :rule sum_simplify)
(step t2 (cl (= (div 1 2) 0)) :rule div_simplify)
(step t3 (cl (= (+ (div 1 2) (div 1 2)) (+ 0 0))) :rule cong :premises (t2 t2))
(step t4 (cl (= (+ 0 0) 0)) :rule sum_simplify)
(step t5 (cl (= 1 (+ (div 1 2) (div 1 2)))) :rule symm :premises (t1))
(step t6 (cl (= 1 0)) :rule trans :premises (t5 t3 t4))
(step t7 (cl (= (= 1 0) false)) :rule eq_simplify)
(step t8 (cl (not (= (= 1 0) false)) (not (= 1 0)) false) :rule equiv_pos2)
(step t9 (cl (not false)) :rule false)
(step t10 (cl) :rule resolution :premises (t6 t7 t8 t9))
