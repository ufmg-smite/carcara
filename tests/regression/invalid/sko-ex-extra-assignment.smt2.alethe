(assume h1 (not (= z 5)))
(step t1 (cl (= (exists ((x Int)) (= z 5)) (= z 5))) :rule qnt_rm_unused)
(anchor :step t2 :args ((:= (x Int) (choice ((x Int)) (= z 5))) (:= (z Int) 5)))
(step t2.t1 (cl (= (= z 5) (= 5 5))) :rule refl)
(step t2 (cl (= (exists ((x Int)) (= z 5)) (= 5 5))) :rule sko_ex)
(step t3 (cl (= (= 5 5) true)) :rule eq_simplify)
(step t4 (cl (= (= z 5) true)) :rule trans :premises (t1 t2 t3))
(step t5 (cl true) :rule true)
(step t6 (cl (not (= (= z 5) true)) (= z 5) (not true)) :rule equiv_pos1)
(step t7 (cl) :rule resolution :premises (t6 t4 t5 h1))
