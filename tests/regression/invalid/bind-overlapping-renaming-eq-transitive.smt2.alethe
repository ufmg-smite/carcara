(assume h1 (exists ((x U) (y U)) (P x y)))
(assume h2 (not (exists ((z U)) (P z z))))
(anchor :step t1 :args ((y U) (z U) (:= (x U) y) (:= (y U) z)))
(step t1.t1 (cl (= x y)) :rule refl)
(step t1.t2 (cl (= y z)) :rule refl)
(step t1.t3 (cl (not (= x y)) (not (= y z)) (= x z)) :rule eq_transitive)
(step t1.t4 (cl (= x z)) :rule resolution :premises (t1.t3 t1.t1 t1.t2))
(step t1.t5 (cl (= (P x y) (P z z))) :rule cong :premises (t1.t4 t1.t2))
(step t1 (cl (= (exists ((x U) (y U)) (P x y)) (exists ((y U) (z U)) (P z z)))) :rule bind)
(step t2 (cl (= (exists ((y U) (z U)) (P z z)) (exists ((z U)) (P z z)))) :rule qnt_rm_unused)
(step t3 (cl (= (exists ((x U) (y U)) (P x y)) (exists ((z U)) (P z z)))) :rule trans :premises (t1 t2))
(step t4 (cl (not (= (exists ((x U) (y U)) (P x y)) (exists ((z U)) (P z z)))) (not (exists ((x U) (y U)) (P x y))) (exists ((z U)) (P z z))) :rule equiv_pos2)
(step t5 (cl (exists ((z U)) (P z z))) :rule resolution :premises (t4 t3 h1))
(step t6 (cl) :rule resolution :premises (t5 h2))
