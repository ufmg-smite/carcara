(define-fun r () Int (choice ((z Int)) (and (>= 5 z) (>= 0 z) (>= (+ z 1) (+ 5 0)))))
(step t1 (cl (and (>= 5 r) (>= 0 r) (>= (+ r 1) (+ 5 0)))) :rule pbblast_bvand_ith_bit :args (5 0))
(step t2 (cl (>= 0 r)) :rule and :premises (t1) :args (1))
(step t3 (cl (>= (+ r 1) (+ 5 0))) :rule and :premises (t1) :args (2))
(step t4 (cl (not (>= 0 r)) (not (>= (+ r 1) (+ 5 0)))) :rule la_generic :args (1 1))
(step t5 (cl) :rule resolution :premises (t2 t3 t4))
