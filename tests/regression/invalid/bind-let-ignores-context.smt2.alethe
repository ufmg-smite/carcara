(assume h1 q)
(anchor :step t1 :args ((:= (q Bool) false)))
(step t1.t1 (cl (= q false)) :rule refl)
(step t1 (cl (= (let ((a 0)) q) (let ((a 0)) false))) :rule bind_let)
(anchor :step t2 :args ((:= (a Int) 0)))
(step t2.t1 (cl (= q q)) :rule refl)
(step t2 (cl (= (let ((a 0)) q) q)) :rule let)
(anchor :step t3 :args ((:= (a Int) 0)))
(step t3.t1 (cl (= false false)) :rule refl)
(step t3 (cl (= (let ((a 0)) false) false)) :rule let)
(step t4 (cl (= q (let ((a 0)) q))) :rule symm :premises (t2))
(step t5 (cl (= q false)) :rule trans :premises (t4 t1 t3))
(step t6 (cl (not (= q false)) (not q) false) :rule equiv_pos2)
(step t7 (cl (not false)) :rule false)
(step t8 (cl) :rule resolution :premises (h1 t5 t6 t7))
