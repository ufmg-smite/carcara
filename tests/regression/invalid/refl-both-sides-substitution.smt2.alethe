(assume h1 (not (forall ((y Int)) (= x y))))
(anchor :step t2 :args ((y Int) (:= (x Int) y)))
(step t2.t1 (cl (= (= x x) (= x y))) :rule refl)
(step t2 (cl (= (forall ((x Int)) (= x x)) (forall ((y Int)) (= x y)))) :rule bind)
(anchor :step t3 :args ((x Int)))
(step t3.t1 (cl (= (= x x) true)) :rule eq_simplify)
(step t3 (cl (= (forall ((x Int)) (= x x)) (forall ((x Int)) true))) :rule bind)
(step t4 (cl (= (forall ((x Int)) true) true)) :rule qnt_simplify)
(step t5 (cl (= (forall ((x Int)) (= x x)) true)) :rule trans :premises (t3 t4))
(step t6 (cl true) :rule true)
(step t7 (cl (not (= (forall ((x Int)) (= x x)) true)) (forall ((x Int)) (= x x)) (not true)) :rule equiv_pos1)
(step t8 (cl (forall ((x Int)) (= x x))) :rule resolution :premises (t7 t5 t6))
(step t9 (cl (not (= (forall ((x Int)) (= x x)) (forall ((y Int)) (= x y)))) (not (forall ((x Int)) (= x x))) (forall ((y Int)) (= x y))) :rule equiv_pos2)
(step t10 (cl) :rule resolution :premises (t9 t2 t8 h1))
