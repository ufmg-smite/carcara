(assume h1 (p 5))
(assume h2 (not (forall ((x Int)) (p x))))
(anchor :step t3 :args ((:= (x Int) 5)))
(step t3.t1 (cl (= (p x) (p 5))) :rule refl)
(step t3 (cl (= (forall ((x Int)) (p x)) (forall ((x Int)) (p 5)))) :rule bind)
(step t4 (cl (= (forall ((x Int)) (p 5)) (p 5))) :rule qnt_rm_unused)
(step t5 (cl (= (forall ((x Int)) (p x)) (p 5))) :rule trans :premises (t3 t4))
(step t6 (cl (forall ((x Int)) (p x)) (not (p 5))) :rule equiv2 :premises (t5))
(step t7 (cl) :rule resolution :premises (t6 h1 h2))
