(set-logic QF_SLIA)
(declare-const x String)
(declare-const L Int)
(assert (not (str.in_re (str.substr x L 1) (re.* (str.to_re "a")))))
(assert (not (<= 1 0)))
(assert (not (< (str.len (str.substr x 1 1)) 1)))
(assert (str.in_re (str.substr (str.substr x 1 1) 0 1) (str.to_re "a")))
(assert (str.in_re (str.substr (str.substr x 1 1) 1 (- (str.len (str.substr x 1 1)) 1)) (re.* (str.to_re "a"))))
(check-sat)
