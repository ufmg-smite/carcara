(assume h1 (>= (str.len "ab") 2))
(step t1 (cl (and (= "ab" (str.++ (str.substr "ab" 0 2) (str.substr "ab" 2 (- (str.len "ab") 2)))) (= (str.len (str.substr "ab" 2 (- (str.len "ab") 2))) 2))) :rule string_decompose :premises (h1) :args (true))
