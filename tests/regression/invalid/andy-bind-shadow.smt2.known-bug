(assume a (= x 0))
(step c0 (cl true) :rule true)
(anchor :step t2 :args ((x Int)))
(step t1a (cl (= (= x 0) true) (not (= x 0)) (not true)) :rule equiv_neg1)
(step t1 (cl (= (= x 0) true)) :rule resolution :premises (t1a a c0))
(step t2 (cl (= (forall ((x Int)) (= x 0)) (forall ((x Int)) true))) :rule bind)
(step t3 (cl (= (forall ((x Int)) true) true)) :rule qnt_rm_unused)
(step t4 (cl (= (forall ((x Int)) (= x 0)) true)) :rule trans :premises (t2 t3))
(step t5a (cl (forall ((x Int)) (= x 0)) (not true)) :rule equiv2 :premises (t4))
(step t5 (cl (forall ((x Int)) (= x 0))) :rule resolution :premises (t5a c0))
(step t6a (cl (or (not (forall ((x Int)) (= x 0))) (= 1 0))) :rule forall_inst :args (1))
(step t6b (cl (not (forall ((x Int)) (= x 0))) (= 1 0)) :rule or :premises (t6a))
(step t6 (cl (= 1 0)) :rule resolution :premises (t6b t5))
(step t7 (cl (= (= 1 0) false)) :rule eq_simplify)
(step t8a (cl (not (= 1 0)) false) :rule equiv1 :premises (t7))
(step t8f (cl (not false)) :rule false)
(step t8 (cl) :rule resolution :premises (t8a t6 t8f))
