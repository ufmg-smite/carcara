(assume h1 (not (= c "")))
(anchor :step t1 :args ((:= (x String) (str.++ x c))))
(step t1.t1 (cl (= x (str.++ x c))) :rule refl)
(step t1.t2 (cl (= "" c)) :rule concat_eq :premises (t1.t1) :args (false))
(step t1.t3 (cl (= c "")) :rule symm :premises (t1.t2))
(step t1 (cl (= (let ((x (str.++ x c))) c) "")) :rule let)
(anchor :step t2 :args ((:= (x String) (str.++ x c))))
(step t2.t1 (cl (= c c)) :rule refl)
(step t2 (cl (= (let ((x (str.++ x c))) c) c)) :rule let)
(step t3 (cl (= c (let ((x (str.++ x c))) c))) :rule symm :premises (t2))
(step t4 (cl (= c "")) :rule trans :premises (t3 t1))
(step t5 (cl) :rule resolution :premises (h1 t4))
