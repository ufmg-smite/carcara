(assume h1 (not (= x 5)))
(anchor :step t2 :args ((:= (x Int) 5)))
(step t2.t1 (cl (= x 5)) :rule refl)
(step t2.t2 (cl (= 5 x)) :rule trans :premises (t2.t1))
(step t2 (cl (= (let ((x 5)) 5) x)) :rule let)
(anchor :step t3 :args ((:= (x Int) 5)))
(step t3.t1 (cl (= 5 5)) :rule refl)
(step t3 (cl (= (let ((x 5)) 5) 5)) :rule let)
(step t4 (cl (= x 5)) :rule trans :premises (t2 t3))
(step t5 (cl) :rule resolution :premises (h1 t4))
