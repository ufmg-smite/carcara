(assume h1 (not (= (f 5) (f x))))
(anchor :step t2 :args ((:= (x Int) 5)))
(step t2.t1 (cl (= x 5)) :rule refl)
(step t2.t2 (cl (= (f 5) (f x))) :rule cong :premises (t2.t1))
(step t2 (cl (= (let ((x 5)) (f 5)) (f x))) :rule let)
(anchor :step t3 :args ((:= (x Int) 5)))
(step t3.t1 (cl (= (f 5) (f 5))) :rule refl)
(step t3 (cl (= (let ((x 5)) (f 5)) (f 5))) :rule let)
(step t4 (cl (= (f 5) (f x))) :rule trans :premises (t3 t2))
(step t5 (cl) :rule resolution :premises (h1 t4))
