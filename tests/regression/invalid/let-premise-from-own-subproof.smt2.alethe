(assume h1 (not (= x 5)))
(anchor :step t2 :args ((:= (x Int) 5)))
(step t2.t1 (cl (= x 5)) :rule refl)
(step t2 (cl (= (let ((x x)) x) 5)) :rule let :premises (t2.t1))
(anchor :step t3 :args ((:= (x Int) x)))
(step t3.t1 (cl (= x x)) :rule refl)
(step t3 (cl (= (let ((x x)) x) x)) :rule let)
(step t4 (cl (= x 5)) :rule trans :premises (t3 t2))
(step t5 (cl) :rule resolution :premises (h1 t4) :args ((= x 5) false))
