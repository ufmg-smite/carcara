(assume h1 (not (let ((z y)) (forall ((x Int)) (p x z)))))
(assume h2 (forall ((y Int)) (p y y)))
(anchor :step t3 :args ((:= (z Int) y)))
(anchor :step t3.t1 :args ((y Int) (:= (x Int) y)))
(step t3.t1.t1 (cl (= (p x z) (p y y))) :rule refl)
(step t3.t1 (cl (= (forall ((x Int)) (p x z)) (forall ((y Int)) (p y y)))) :rule bind)
(step t3 (cl (= (let ((z y)) (forall ((x Int)) (p x z))) (forall ((y Int)) (p y y)))) :rule let)
(step t4 (cl (not (= (let ((z y)) (forall ((x Int)) (p x z))) (forall ((y Int)) (p y y)))) (let ((z y)) (forall ((x Int)) (p x z))) (not (forall ((y Int)) (p y y)))) :rule equiv_pos1)
(step t5 (cl) :rule resolution :premises (t4 t3 h2 h1))
