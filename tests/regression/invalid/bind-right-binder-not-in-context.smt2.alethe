(assume h1 (P y))
(assume h2 (not (forall ((x Int)) (P x))))
(anchor :step t1 :args ((y Int) (:= (x Int) y)))
(step t1.t1 (cl (= (P x) (P y))) :rule refl)
(step t1 (cl (= (forall ((x Int)) (P x)) (forall ((w Int)) (P y)))) :rule bind)
(step t2 (cl (= (forall ((w Int)) (P y)) (P y))) :rule qnt_rm_unused)
(step t3 (cl (= (forall ((x Int)) (P x)) (P y))) :rule trans :premises (t1 t2))
(step t4 (cl (forall ((x Int)) (P x)) (not (P y))) :rule equiv2 :premises (t3))
(step t5 (cl) :rule resolution :premises (t4 h1 h2))
