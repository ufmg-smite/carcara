(anchor :step t1 :args ((:= (x Int) (+ x 1))))
(step t1.t1 (cl (= x (+ x 1))) :rule refl)
(step t1.t2 (cl (= (+ x 1) x)) :rule symm :premises (t1.t1))
(step t1.t3 (cl (not (= (+ x 1) x))) :rule la_generic :args (1))
(step t1.t4 (cl) :rule resolution :premises (t1.t2 t1.t3))
(step t1.t5 (cl (= 5 6)) :rule weakening :premises (t1.t4))
(step t1 (cl (= (let ((x (+ x 1))) 5) 6)) :rule let)
(anchor :step t2 :args ((:= (x Int) (+ x 1))))
(step t2.t1 (cl (= 5 5)) :rule refl)
(step t2 (cl (= (let ((x (+ x 1))) 5) 5)) :rule let)
(step t3 (cl (= 5 (let ((x (+ x 1))) 5))) :rule symm :premises (t2))
(step t4 (cl (= 5 6)) :rule trans :premises (t3 t1))
(step t5 (cl (not (= 5 6))) :rule la_generic :args (1))
(step t6 (cl) :rule resolution :premises (t4 t5))
