(assume h1 (exists ((x U) (y U)) (P x y)))
(assume h2 (not (exists ((y U)) (P y y))))
(anchor :step t1 :args ((y U) (z U) (:= (x U) y) (:= (y U) z)))
(step t1.t1 (cl (= x y)) :rule refl)
(step t1.t2 (cl (= y x)) :rule symm :premises (t1.t1))
(step t1.t3 (cl (= y y)) :rule trans :premises (t1.t2 t1.t1))
(step t1.t4 (cl (= (P x y) (P y y))) :rule cong :premises (t1.t1 t1.t3))
(step t1 (cl (= (exists ((x U) (y U)) (P x y)) (exists ((y U) (z U)) (P y y)))) :rule bind)
(step t2 (cl (= (exists ((y U) (z U)) (P y y)) (exists ((y U)) (P y y)))) :rule qnt_rm_unused)
(step t3 (cl (= (exists ((x U) (y U)) (P x y)) (exists ((y U)) (P y y)))) :rule trans :premises (t1 t2))
(step t4 (cl (not (= (exists ((x U) (y U)) (P x y)) (exists ((y U)) (P y y)))) (not (exists ((x U) (y U)) (P x y))) (exists ((y U)) (P y y))) :rule equiv_pos2)
(step t5 (cl (exists ((y U)) (P y y))) :rule resolution :premises (t4 t3 h1))
(step t6 (cl) :rule resolution :premises (t5 h2))
