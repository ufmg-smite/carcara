(assume a0 (forall ((w Int)) (and (= y (f x)) (forall ((x Int)) (exists ((y Int)) (= y (f x)))))))
(assume a1 (not (forall ((w Int)) (and (= y (f x)) (forall ((y Int)) (exists ((x Int)) (= y (f x))))))))
(step t1 (cl (= (forall ((w Int)) (and (= y (f x)) (forall ((x Int)) (exists ((y Int)) (= y (f x)))))) (forall ((w Int)) (and (= y (f x)) (forall ((y Int)) (exists ((x Int)) (= y (f x)))))))) :rule refl)
(step t2 (cl (not (forall ((w Int)) (and (= y (f x)) (forall ((x Int)) (exists ((y Int)) (= y (f x))))))) (forall ((w Int)) (and (= y (f x)) (forall ((y Int)) (exists ((x Int)) (= y (f x))))))) :rule equiv1 :premises (t1))
(step t3 (cl) :rule resolution :premises (t2 a0 a1))
