(assume h1 (p y))
(assume h2 (not (forall ((x Int)) (p x))))
(anchor :step t3 :args ((y Int) (:= (x Int) y)))
(step t3.t1 (cl (= (p x) (p y))) :rule refl)
(step t3 (cl (= (forall ((x Int)) (p x)) (forall ((x Int)) (p y)))) :rule bind)
(step t4 (cl (= (forall ((x Int)) (p y)) (p y))) :rule qnt_rm_unused)
(step t5 (cl (= (forall ((x Int)) (p x)) (p y))) :rule trans :premises (t3 t4))
(step t6 (cl (forall ((x Int)) (p x)) (not (p y))) :rule equiv2 :premises (t5))
(step t7 (cl) :rule resolution :premises (t6 h1 h2))
