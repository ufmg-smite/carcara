(include "../theories/theory.eo")
(include "../programs/arith.eo")
(include "../programs/programs.eo")

; Rules that introduce tautologies.

;-----------------------
; Rule 26: eq_transitive
;-----------------------

; program: $check_eq_transitive_remaining_equalities
; args:
; - t2 A: Left-hand side of the next equation that we should look for.
; - tn A: Right-hand side of the last equation.
; - assumptions Bool: Clause with the remaining assumptions passed to eq_transitive.
; return: >
;   A boolean indicating if there is a chain of equivalences between terms, beginning
;   from `t2`, following the equalities contained into `assumptions`, and reaching
;   to term `tn`.
(program $check_eq_transitive_remaining_equalities ((A Type) (t2 A) (t3 A)
                                                    (tn_1 A) (tn A) 
                                                    (tail Bool :list))

         :signature (A A Bool) Bool

         (
          (; Last case
           ($check_eq_transitive_remaining_equalities tn_1 tn (@cl (not (= tn_1 tn))))

           true
           )

          (; Intermediate step.
           ($check_eq_transitive_remaining_equalities t2 tn (@cl (not (= t2 t3)) tail))

           ($check_eq_transitive_remaining_equalities t3 tn tail)
           )
          )
         )

; program: $check_eq_transitive_from_first_equality
; args:
; - last_equality Bool: >
;   Last disjunct present in the conclusion clause passed to `eq_transitive`.
;   It must be an equality among arbitrary terms.
; - assumptions Bool: Clause with the remaining assumptions passed to eq_transitive.
; return: >
;   A boolean indicating if there is a chain of equivalences between terms, beginning
;   from the left-hand side of `last-equality`, following the equalities contained 
;   into `assumptions`, and reaching to right-hand side of `last-equality`.
(program $check_eq_transitive_from_first_equality ((A Type) (t1 A) (t2 A) (tn A)
                                                   (tail Bool :list))

         :signature (Bool Bool) Bool

         (
          (; First case
           ($check_eq_transitive_from_first_equality (= t1 tn) (@cl (not (= t1 t2)) tail))

           ($check_eq_transitive_remaining_equalities t2 tn tail)
           )
          )
         )

; program: $check_trans
; args:
; - conclusion Bool: Conclusion given to rule `eq_transitive`. Must be built with @cl.
; return: >
;   A boolean indicating if `conclusion` is of the form
;   ¬(𝑡1 ≈ 𝑡2), … , ¬(𝑡𝑛−1 ≈ 𝑡𝑛), 𝑡1 ≈ 𝑡𝑛
(program $check_eq_transitive ((hd Bool) (tail Bool :list))
  :signature (Bool) Bool
  (
   (
    ($check_eq_transitive (@cl hd tail))
    
    (eo::define

     (
      (last_equality ($f_list_last_element @cl false (@cl hd tail)))
      )

     (eo::define
      
      (
       (assumptions ($f_list_remove_elem @cl (@cl hd tail) last_equality false))
       )

      ($check_eq_transitive_from_first_equality last_equality assumptions)))
    )
   )
  )

; rule: eq_transitive
; requires: >
;   For "conclusion" to be of the form:
;   ¬(𝑡1 ≈𝑡2), … , ¬(𝑡𝑛−1 ≈𝑡𝑛), 𝑡1 ≈𝑡𝑛
; conclusion-explicit: >
;   Conclusion should be a clause built with @cl, satisfying the described
;   side-condition.
(declare-rule eq_transitive ((hd Bool) (tail Bool :list))
  :requires ((($check_eq_transitive (@cl hd tail)) true))
  :conclusion-explicit (@cl hd tail)
)

;-----------------------
; Rule 27: eq_congruent
;-----------------------

; program: $check_n_ary_application_eq_congruent
; args:
; - eq Bool: Last equality in the conclusion passed to the eq_congruent rule.
; - assumptions Bool: >
;    Clause with the assumptions of the form ¬(𝑡i ≈ 𝑢i) present in the conclusion
;    passed to the rule, but in the reverse order.
; return: >
;    A boolean indicating if `eq` and `assumptions` correspond to the proper
;    application of the eq_congruent rule, for a n-ary operator. Note that, in 
;    this case, we are dealing with the single application of a n-ary operator. No 
;    associativity is involved.
(program $check_n_ary_application_eq_congruent ((T Type) (U Type) 
                                                (f (-> T U U)) (f2 (-> T U U)) 
                                                (t1 T) (t2 T)
                                                (tail Bool :list))
    :signature (Bool Bool) Bool
    (
     (
      ($check_n_ary_application_eq_congruent (= (f t1) (f t2)) (@cl (not (= t1 t2))))

      true
      )

     ( ; TODO: ill-typed?
      ($check_n_ary_application_eq_congruent (= (f t1) (f2 t2)) (@cl (not (= t1 t2)) tail))

      ($check_n_ary_application_eq_congruent (= f f2) tail)
      )
     )
    )

; program: $check_eq_congruent
; args:
; - conclusion Bool: Conclusion clause given to rule cong.
; return: >
;   A boolean indicating if `conclusion` has the form 
;   ¬(𝑡1 ≈ 𝑢1), … ,¬( 𝑡𝑛 ≈ 𝑢𝑛), (𝑓 𝑡1 ⋯ 𝑡𝑛) ≈ (𝑓 𝑢1 ⋯ 𝑢𝑛), for some n-ary 
;   function `f`.
(program $check_eq_congruent ((hd Bool) (tail Bool :list))
  :signature (Bool) Bool
  (
   (
    ($check_eq_congruent (@cl hd tail))

    (eo::define

     (
      (equality ($f_list_last_element @cl false (@cl hd tail)))
      )
     
     (eo::define
      
      (
       (assumptions ($f_list_remove_elem @cl (@cl hd tail) equality false))
       )

     ($check_n_ary_application_eq_congruent equality 
                                            (eo::list_rev @cl assumptions))))
     )
    )
   )


; rule: eq_congruent
; requires: >
;   For the conclusion to be built with @cl and to have the form:
;   ¬(𝑡1 ≈ 𝑢1), … ,¬( 𝑡𝑛 ≈ 𝑢𝑛), (𝑓 𝑡1 ⋯ 𝑡𝑛) ≈ (𝑓 𝑢1 ⋯ 𝑢𝑛)
; conclusion-explicit: A clause built with @cl.
(declare-rule eq_congruent ((hd Bool) (tail Bool :list))
  :requires ((($check_eq_congruent (@cl hd tail)) true))
  :conclusion-explicit (@cl hd tail)
)

;---------------------------
; Rule 28: eq_congruent_pred
;---------------------------

; program: $check_n_ary_application_eq_congruent_pred
; args:
; - not_p Bool: >
;   Second-to-last disjunct in the conclusion passed to the eq_congruent_pred rule.
; - p Bool: Last disjunct in the conclusion passed to the eq_congruent rule.
; - assumptions Bool: >
;    Clause with the assumptions of the form ¬(𝑡i ≈ 𝑢i) present in the conclusion
;    passed to the rule, but in the reverse order.
; return: >
;    A boolean indicating if `not_p`, `p` and `assumptions` correspond to the proper
;    application of the eq_congruent_pred rule, for a n-ary predicate.
(program $check_n_ary_application_eq_congruent_pred ((T Type) (U Type) 
                                                     (p (-> T U Bool)) (p2 (-> T U Bool)) 
                                                     (t1 T) (t2 T)
                                                     (tail Bool :list))
    :signature (Bool Bool Bool) Bool
    (
     (
      ($check_n_ary_application_eq_congruent_pred (not (p t1)) (p t2) 
                                                  (@cl (not (= t1 t2))))

      true
      )

     ( ; TODO: ill-typed?
      ($check_n_ary_application_eq_congruent_pred (not (p t1)) (p2 t2)
                                                  (@cl (not (= t1 t2)) tail))

      ($check_n_ary_application_eq_congruent_pred (not p) p2 tail)
      )
     )
    )

; program: $check_eq_congruent_pred
; args:
; - conclusion Bool: Conclusion clause given to rule eq_congruent_pred.
; return: >
;   A boolean indicating if `conclusion` has the form 
;   ¬(𝑡1 ≈ 𝑢1), … ,¬( 𝑡𝑛 ≈ 𝑢𝑛), ¬(p 𝑡1 ⋯ 𝑡𝑛), (p 𝑢1 ⋯ 𝑢𝑛), for some n-ary 
;   predicate `p`.
(program $check_eq_congruent_pred ((hd Bool) (tail Bool :list))
  :signature (Bool) Bool
  (
   (
    ($check_eq_congruent_pred (@cl hd tail))

    (eo::define

     (
      (predicate_p ($f_list_last_element @cl false (@cl hd tail)))
      )
     
     (eo::define
      
      (
       (remaining_elements ($f_list_remove_elem @cl (@cl hd tail) predicate_p false))
       )

      (eo::define

       (
        (predicate_not_p ($f_list_last_element @cl false remaining_elements))
        )
       
       (eo::define
        
        (
         (assumptions ($f_list_remove_elem @cl remaining_elements predicate_not_p false))
         )

        ($check_n_ary_application_eq_congruent_pred predicate_not_p predicate_p
                                                    (eo::list_rev @cl assumptions))))
      )))
   )
  )

; rule: eq_congruent_pred
; requires: >
;   For the conclusion to be built with @cl and to have the form:
;   ¬(𝑡1 ≈ 𝑢1), … ,¬( 𝑡𝑛 ≈ 𝑢𝑛), ¬(P 𝑡1 ⋯ 𝑡𝑛), (P 𝑢1 ⋯ 𝑢𝑛), 
;   where 𝑃 is a predicate symbol.
; conclusion-explicit: A clause built with @cl satisfying the previous side-condition.
(declare-rule eq_congruent_pred ((hd Bool) (tail Bool :list))
  :requires ((($check_eq_congruent_pred (@cl hd tail)) true))
  :conclusion-explicit (@cl hd tail)
)

;------------------
; Rule 52: xor_pos1
;------------------

; rule: xor_pos1
; conclusion-explicit: Conclusion must be of the form ¬(xor 𝜑1 𝜑2), 𝜑1, 𝜑2.
(declare-rule xor_pos1 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (not (xor phi_1 phi_2)) phi_1 phi_2)
)

;------------------
; Rule 53: xor_pos2
;------------------

; rule: xor_pos2
; conclusion-explicit: Conclusion must be of the form ¬(xor 𝜑1 𝜑2), ¬𝜑1, ¬𝜑2.
(declare-rule xor_pos2 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (not (xor phi_1 phi_2)) (not phi_1) (not phi_2))
)

;------------------
; Rule 54: xor_neg1
;------------------

; rule: xor_neg1
; conclusion-explicit: Conclusion must be of the form (xor 𝜑1 𝜑2), 𝜑1, ¬𝜑2.
(declare-rule xor_neg1 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (xor phi_1 phi_2) phi_1 (not phi_2))
)

;------------------
; Rule 55: xor_neg2
;------------------

; rule: xor_neg2
; conclusion-explicit: Conclusion must be of the form (xor 𝜑1 𝜑2), ¬𝜑1, 𝜑2.
(declare-rule xor_neg2 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (xor phi_1 phi_2) (not phi_1) phi_2)
)

;--------------------
; Rule 61: equiv_neg1
;--------------------

; rule: equiv_neg1
; conclusion-explicit: Conclusion must be of the form 𝜑1 ≈ 𝜑2, ¬𝜑1, ¬𝜑2.
(declare-rule equiv_neg1 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (= phi_1 phi_2) (not phi_1) (not phi_2))
)

;--------------------
; Rule 62: equiv_neg2
;--------------------

; rule: equiv_neg2
; conclusion-explicit: Conclusion must be of the form 𝜑1 ≈ 𝜑2, 𝜑1, 𝜑2.
(declare-rule equiv_neg2 ((phi_1 Bool) (phi_2 Bool))
  :conclusion-explicit (@cl (= phi_1 phi_2) phi_1 phi_2)
)

;------------------
; Rule 65: ite_pos1
;------------------

; rule: ite_pos1
; conclusion-explicit: Conclusion must be of the form ¬(ite 𝜑1 𝜑2 𝜑3), 𝜑1, 𝜑3.
(declare-rule ite_pos1 ((phi_1 Bool) (phi_2 Bool) (phi_3 Bool))
  :conclusion-explicit (@cl (not (ite phi_1 phi_2 phi_3)) phi_1 phi_3)
)

;------------------
; Rule 66: ite_pos2
;------------------

; rule: ite_pos2
; conclusion-explicit: Conclusion must be of the form ¬(ite 𝜑1 𝜑2 𝜑3), ¬𝜑1, 𝜑2.
(declare-rule ite_pos2 ((phi_1 Bool) (phi_2 Bool) (phi_3 Bool))
  :conclusion-explicit (@cl (not (ite phi_1 phi_2 phi_3)) (not phi_1) phi_2)
)

;------------------
; Rule 67: ite_neg1
;------------------

; rule: ite_neg1
; conclusion-explicit: Conclusion must be of the form (ite 𝜑1 𝜑2 𝜑3), 𝜑1, ¬𝜑3.
(declare-rule ite_neg1 ((phi_1 Bool) (phi_2 Bool) (phi_3 Bool))
  :conclusion-explicit (@cl (ite phi_1 phi_2 phi_3) phi_1 (not phi_3))
)

;------------------
; Rule 68: ite_neg2
;------------------

; rule: ite_neg2
; conclusion-explicit: Conclusion must be of the form (ite 𝜑1 𝜑2 𝜑3), 𝜑1, ¬𝜑3.
(declare-rule ite_neg2 ((phi_1 Bool) (phi_2 Bool) (phi_3 Bool))
  :conclusion-explicit (@cl (ite phi_1 phi_2 phi_3) (not phi_1) (not phi_2))
)

;------------------------
; Rule 71: connective_def
;------------------------


; program: $connective_def
; args:
; - formula Bool: An arbitrary formula.
; return: >
;   A formula equivalent to `formula`, using the dual operators of those in
;   `formula`, according to rule `connective_def`.
; note: >
;   Doing so is cheaper than writing an Eunoia program that pattern matches
;   over the conclusion passed to `connective_def`.
(program $connective_def ((phi1 Bool) (phi2 Bool :list) (phi3 Bool)
                          (varlist @VarList) (body Bool))
  :signature (Bool) Bool
  (
   (
    ($connective_def (xor phi1 phi2))
    
    ($f_list_cons or 
                  ($f_list_cons and (not phi1) phi2)
                  ($f_list_cons and phi1 (not phi2)))
    )

   (
    ($connective_def (= phi1 phi2))
    
    ($f_list_cons and (=> phi1 phi2) (=> phi2 phi1))
    )

   (
    ($connective_def (ite phi1 phi2 phi3))
    
    ($f_list_cons and (=> phi1 phi2) (=> (not phi1) phi3))
    )

   (
    ($connective_def (forall varlist body))

    (not (exists varlist (not body)))
    )

   (
    ($connective_def (exists varlist body))

    (not (forall varlist (not body)))
    )
  )
)


; program: $check_connective_def
; args:
; - conclusion Bool: Conclusion passed to rule `connective_def`
; return: >
;   A boolean indicating if `conclusion` has one of the following forms:
;   - (xor 𝜑1 𝜑2) ≈((¬𝜑1 ∧ 𝜑2) ∨(𝜑1 ∧¬𝜑2))
;   - (𝜑1 ≈ 𝜑2) ≈ ((𝜑1 →𝜑2) ∧ (𝜑2 →𝜑1))
;   - (ite 𝜑1 𝜑2 𝜑3) ≈ ((𝜑1 → 𝜑2) ∧(¬𝜑1 → 𝜑3))
;   - (∀𝑥1, … , 𝑥𝑛. 𝜑) ≈ ¬(∃𝑥1, … , 𝑥𝑛. ¬𝜑)
;   - (∃𝑥1, … , 𝑥𝑛. 𝜑) ≈ ¬(∀𝑥1, … , 𝑥𝑛. ¬𝜑)
(program $check_connective_def ((lhs Bool) (rhs Bool))
  :signature (Bool) Bool
  (
   (
    ($check_connective_def (@cl (= lhs rhs)))
    ;   Doing so is cheaper than writing an Eunoia program that pattern matches
    ;   over the conclusion passed to `connective_def`.
    ($eo_is_eq ($connective_def lhs) rhs)
    )
  )
)

; rule: connective_def
; requires: For the conclusion to satisfy the `$check_connective_def` predicate.
; conclusion-explicit: A conclusion of the form (@cl (= lhs rhs)).
(declare-rule connective_def ((lhs Bool) (rhs Bool))
  :requires ((($check_connective_def (@cl (= lhs rhs))) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 72: and_simplify
;-----------------------

; program: $remove_leading_negations
; args:
; - formula Bool: An arbitrary formula.
; return: >
;   The result from removing leading double negations from `formula`.
(program $remove_leading_negations ((formula Bool))
         :signature (Bool) Bool
         (
          (
           ($remove_leading_negations (not (not formula)))

           ($remove_leading_negations formula)
           )

          (; { `formula` does not begin with a double negation }
           ($remove_leading_negations formula)

           formula
           )
          )
         )

; program: $remove_leading_negations_in_conjuncts
; args:
; - conjunct Bool: An conjunct built with `or`.
; return: >
;   The result from removing leading double negations from each conjunct
;   in `conjunct`.
(program $remove_leading_negations_in_conjuncts ((conjunct Bool) (conjuncts Bool :list))
         :signature (Bool) Bool
         (
          (
           ($remove_leading_negations_in_conjuncts (and conjunct conjuncts))

           ($f_list_cons and
                         ($remove_leading_negations conjunct)
                         ($remove_leading_negations_in_conjuncts conjuncts))
           )

          (; { `formula` is not a conjunct }
           ($remove_leading_negations_in_conjuncts true)

           true
           )
          )
         )

; program: $and_simplify_small_step
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations:
;   - ⊤∧⋯∧⊤⇒⊤
;   - 𝜑1 ∧⋯∧𝜑𝑛 ⇒ 𝜑1 ∧⋯∧𝜑𝑛′ where the right-hand side has all ⊤ literals removed.
;   - 𝜑1 ∧⋯∧𝜑𝑛⇒𝜑1 ∧⋯∧𝜑𝑛′ where the right-hand side has all repeated literals removed.
;   - 𝜑1 ∧⋯∧⊥∧⋯∧𝜑𝑛 ⇒ ⊥
;   - 𝜑1 ∧⋯∧𝜑𝑖∧⋯∧𝜑𝑗∧⋯∧𝜑𝑛 ⇒ ⊥and 𝜑𝑖, 𝜑𝑗 are such that one has the form ¬ 𝜓 
;     and the other is 𝜓
; note: PRE : { $remove_leading_negations_in_conjuncts `formula` = `formula`}
(program $and_simplify_small_step ((conjunct Bool) (conjuncts Bool :list))
  :signature (Bool) Bool
  (
   (
    ($and_simplify_small_step (and true conjuncts))

    conjuncts
    )

   (
    ($and_simplify_small_step (and false conjuncts))

    false
    )

   (
    ($and_simplify_small_step (and (not conjunct) conjuncts))

    (eo::ite ($eo_is_eq conjuncts true)

             (not conjunct)

              ; { not ($eo_is_eq conjuncts true) }
             (eo::ite ($eo_is_eq conjuncts false)

                      false

                      ; { not ($eo_is_eq conjuncts true) }
                      (eo::ite ($f_list_contains_elem and (not conjunct) conjuncts)

                               conjuncts

                               ; { not ($f_list_contains_elem and (not conjunct) conjuncts) }
                               (eo::ite ($f_list_contains_elem and conjunct conjuncts)

                                        ; We have a and (not conjunct) conjunct ... = false
                                        false

                                        ; { not ($f_list_contains_elem and conjunct conjuncts) }
                                        (and (not conjunct) conjuncts)))))
    )

   (
    ($and_simplify_small_step (and conjunct conjuncts))

    (eo::ite ($eo_is_eq conjuncts true)

             conjunct

              ; { not ($eo_is_eq conjuncts true) }
             (eo::ite ($eo_is_eq conjuncts false)

                      false

                      ; { not ($eo_is_eq conjuncts false) }
                      (eo::ite ($f_list_contains_elem and conjunct conjuncts)

                               conjuncts

                               ; { not ($f_list_contains_elem and conjunct conjuncts) }
                               (eo::ite ($f_list_contains_elem and (not conjunct) conjuncts)

                                        ; We have a and (not conjunct) conjunct ... = false
                                        false

                                        ; { not ($f_list_contains_elem and (not conjunct) conjuncts) }
                                        (and conjunct conjuncts)))))
    )

   ( ; { conjunct != and ... }
    ($and_simplify_small_step conjunct)

    conjunct
    )

   
   )
  )

; program: $and_simplify_rec
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying the equivalence-preserving transformations described
;   in `$and_simplify_small_step` until a fixed point is reached.
; note: PRE : { $remove_leading_negations_in_conjuncts `formula` = `formula`}
(program $and_simplify_rec ((conjunct Bool) (conjuncts Bool :list))
  :signature (Bool) Bool
  (
   (
    ($and_simplify_rec (and conjunct conjuncts))

    (eo::define 

     ((conjuncts_simplified ($and_simplify_rec conjuncts)))

     (eo::ite ($eo_is_eq conjuncts_simplified conjuncts)

              ; We continue reducing, right-to-left.
              (eo::define 

               ((whole_conjunct_simplified 

                 ($and_simplify_small_step (and conjunct conjuncts))))

               (eo::ite ($eo_is_eq whole_conjunct_simplified 
                                   (and conjunct conjuncts))

                        ; We reached to a fixed point.
                        (and conjunct conjuncts)

                        ; { not ($eo_is_eq whole_conjunct_simplified 
                        ;                  (and conjunct conjuncts)) }
                        ($and_simplify_rec whole_conjunct_simplified)))

              ; { not ($eo_is_eq conjuncts_simplified conjuncts) }
              ($and_simplify_rec 
               ($f_list_cons and conjunct conjuncts_simplified))))
    )

   ( ; { conjunct != and ...}
     ($and_simplify_rec conjunct)

     conjunct
     )
    )
  )

; program: $check_and_simplify
; args:
; - lhs Bool: >
;   The left-hand side of the equality in the conclusion passed to rule 
;   `and_simplify`
; - rhs: >
;   The right-hand side of the equality in the conclusion passed to rule 
;   `and_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs` using 
;   `$and_simplify_rec`.
(program $check_and_simplify ((lhs Bool) (rhs Bool) (hd Bool) (tl Bool :list))
  :signature (Bool Bool) Bool
  (
   (
    ($check_and_simplify lhs (and hd tl))

    ($f_list_equal_mod_commut
     
     and
     ; rhs will have an extra true, we add it to the lhs.
     ($f_list_cons and true 
                   ($and_simplify_rec ($remove_leading_negations_in_conjuncts lhs)))

               (and hd tl))
    )

   (
    ($check_and_simplify lhs rhs)

    ($f_list_equal_mod_commut
     and
     ($and_simplify_rec ($remove_leading_negations_in_conjuncts lhs))
     rhs)
    )
  )
)

; rule: not_simplify
; requires: >
;   For `lhs` to be reducible to `rhs` following the rules 
;   in `$and_simplify_rec`.
; conclusion-explicit: (@cl (= lhs rhs))
(declare-rule and_simplify ((lhs Bool) (rhs Bool))
  :requires ((($check_and_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 73: or_simplify
;-----------------------

; program: $remove_leading_negations_in_disjuncts
; args:
; - disjunct Bool: An disjunct built with `or`.
; return: >
;   The result from removing leading double negations from each disjunct
;   in `disjunct`.
(program $remove_leading_negations_in_disjuncts ((disjunct Bool) (disjuncts Bool :list))
         :signature (Bool) Bool
         (
          (
           ($remove_leading_negations_in_disjuncts (or disjunct disjuncts))

           ($f_list_cons or 
                         ($remove_leading_negations disjunct)
                         ($remove_leading_negations_in_disjuncts disjuncts))
           )

          (; { `formula` is not a disjunct }
           ($remove_leading_negations_in_disjuncts false)

           false
           )
          )
         )

; program: $or_simplify_small_step
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations:
;   - ⊥∨⋯∨⊥ ⇒ ⊥
;   - 𝜑1 ∨ ⋯ ∨ 𝜑𝑛 ⇒ 𝜑1 ∨ ⋯ ∨ 𝜑𝑛′ where the right-hand side has some ⊥ literal 
;     removed.
;   - 𝜑1 ∨ ⋯ ∨ 𝜑𝑛 ⇒ 𝜑1 ∨ ⋯ ∨ 𝜑𝑛′ where the right-hand side has some repeated 
;     literal removed.
;   - ⊤ ∨ ⋯ ∨ 𝜑𝑛 ⇒ ⊤
;   - 𝜑𝑖 ∨ ⋯ ∨ 𝜑𝑗 ∨ ⋯ ∨ 𝜑𝑛 ⇒ ⊤ and 𝜑𝑖 , 𝜑𝑗 are such that one is the
;     negation of the other formula
; note: PRE : { $remove_leading_negations_in_disjuncts `formula` = `formula`}
(program $or_simplify_small_step ((disjunct Bool) (disjuncts Bool :list))
  :signature (Bool) Bool
  (
   (
    ($or_simplify_small_step (or false disjuncts))

    disjuncts
    )

   (
    ($or_simplify_small_step (or true disjuncts))

    true
    )
   
   (
    ($or_simplify_small_step (or (not disjunct) disjuncts))

    (eo::ite ($eo_is_eq disjuncts false)

             (not disjunct)

              ; { not ($eo_is_eq disjuncts false) }
             (eo::ite ($eo_is_eq disjuncts true)

                      true

                      ; { not ($eo_is_eq disjuncts true) }
                      (eo::ite ($f_list_contains_elem or (not disjunct) disjuncts)

                               disjuncts

                               ; { not ($f_list_contains_elem or (not disjunct) disjuncts) }
                               (eo::ite ($f_list_contains_elem or disjunct disjuncts)

                                        ; We have a or (not disjunct) disjunct ... = true
                                        true

                                        ; { not ($f_list_contains_elem or disjunct disjuncts) }
                                        (or (not disjunct) disjuncts)))))
             )

   ( ; { disjunct != true, false, not ... }
    ($or_simplify_small_step (or disjunct disjuncts))

    (eo::ite ($eo_is_eq disjuncts false)

             disjunct

             ; { not ($eo_is_eq disjuncts false) }
             (eo::ite ($eo_is_eq disjuncts true)

                      true

                      ; { not ($eo_is_eq disjuncts true) }
                      (eo::ite ($f_list_contains_elem or disjunct disjuncts)

                               disjuncts

                               ; { not ($f_list_contains_elem or disjunct disjuncts) }
                               (eo::ite ($f_list_contains_elem or (not disjunct) disjuncts)

                                        ; We have a or (not disjunct) disjunct ... = true
                                        true

                                        ; { not ($f_list_contains_elem or (not disjunct) disjuncts) }
                                        (or disjunct disjuncts)))))
    )

   ( ; { disjunct != or ... }
    ($or_simplify_small_step disjunct)

    disjunct
    )
  )
)

; program: $or_simplify_rec
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying the equivalence-preserving transformations described
;   in `$or_simplify_small_step` until a fixed point is reached.
; note: PRE : { $remove_leading_negations_in_disjuncts `formula` = `formula`}
(program $or_simplify_rec ((disjunct Bool) (disjuncts Bool :list))
  :signature (Bool) Bool
  (
   (
    ($or_simplify_rec (or disjunct disjuncts))

    (eo::define 

     ((disjuncts_simplified ($or_simplify_rec disjuncts)))

     (eo::ite ($eo_is_eq disjuncts_simplified disjuncts)

              ; We continue reducing, right-to-left.
              (eo::define 

               ((whole_disjunct_simplified 

                 ($or_simplify_small_step (or disjunct disjuncts))))

               (eo::ite ($eo_is_eq whole_disjunct_simplified 
                                   (or disjunct disjuncts))

                        ; We reached a fixed point.
                        (or disjunct disjuncts)

                        ; { not ($eo_is_eq whole_disjunct_simplified 
                        ;                  (or disjunct disjuncts)) }
                        ($or_simplify_rec whole_disjunct_simplified)))

              ; { not ($eo_is_eq disjuncts_simplified disjuncts) }
              ($or_simplify_rec 
               ($f_list_cons or disjunct disjuncts_simplified))))
    )

   ( ; { disjunct != or ...}
     ($or_simplify_rec disjunct)

     disjunct
     )
    )
  )

; program: $check_or_simplify
; args:
; - lhs Bool: >
;   The left-hand side of the equality in the conclusion passed to rule 
;   `or_simplify`
; - rhs: >
;   The right-hand side of the equality in the conclusion passed to rule 
;   `or_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs` using 
;   `$or_simplify_rec`.
(program $check_or_simplify ((lhs Bool) (rhs Bool) (hd Bool) (tl Bool :list))
  :signature (Bool Bool) Bool
  (
   (
    ($check_or_simplify lhs (or hd tl))

    ($f_list_equal_mod_commut_and_length
     or
     ; rhs will have an extra false, we add it to the lhs.
     ($f_list_cons or false
                   ($or_simplify_rec 
                    ($remove_leading_negations_in_disjuncts lhs)))
     (or hd tl)
     )
    )

   (; { rhs is an atom }
    ($check_or_simplify lhs rhs)

    ($f_list_equal_mod_commut_and_length
     or
     ($or_simplify_rec ($remove_leading_negations_in_disjuncts lhs))
     rhs
     )
    )
  )
)

; rule: or_simplify
; requires: >
;   For `lhs` to be reducible to `rhs` following the rules 
;   in `$or_simplify_rec`.
; conclusion-explicit: (@cl (= lhs rhs))
(declare-rule or_simplify ((lhs Bool) (rhs Bool))
  :requires ((($check_or_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 74: not_simplify
;-----------------------

; program: $not_simplify_rec
; args:
; - psi Bool: A formula.
; return: >
;   The result from applying the following equivalence-preserving transformations until
;   a fixed point is reached:
;   - ¬(¬ ᴪ) ⇒ ᴪ
;   - ¬⊥ ⇒ ⊤
;   - ¬⊤ ⇒ ⊥
(program $not_simplify_rec ((psi Bool))
  :signature (Bool) Bool
  (
   (
    ($not_simplify_rec (not (not psi)))

    ($not_simplify_rec psi)
    )

   (
    ($not_simplify_rec (not false))

    true
    )

   (
    ($not_simplify_rec (not true))

    false
    )

   (; { psi does not being with double not, nor has the form (not false), (not true)}
    ($not_simplify_rec psi)

    psi
    )
  )
)

; program: $check_not_simplify
; args:
; - not_phi Bool: >
;   The left-hand side of the equality in the conclusion passed to rule 
;   `not_simplify`
; - psi Bool: >
;   The right-hand side of the equality in the conclusion passed to rule 
;   `not_simplify`
; return: >
;   A boolean indicating if `not_phi` can be reduced to `psi` using 
;   `$not_simplify_rec`.
(program $check_not_simplify ((not_phi Bool) (psi Bool))
  :signature (Bool Bool) Bool
  (
   (
    ($check_not_simplify not_phi psi) 

    ($eo_is_eq ($not_simplify_rec not_phi) psi)
    )
  )
)

; rule: not_simplify
; requires: >
;   For `(not phi)` to be reducible to `psi` following the rules 
;   in `$not_simplify_rec`.
; conclusion-explicit: (@cl (= (not phi) psi))
(declare-rule not_simplify ((phi Bool) (psi Bool))
  :requires ((($check_not_simplify (not phi) psi) true))
  :conclusion-explicit (@cl (= (not phi) psi))
)

;-----------------------
; Rule 77: bool_simplify
;-----------------------

; program: $bool_simplify_small_step
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations:
;   - ¬(𝜑1 →𝜑2) ⇒(𝜑1 ∧¬𝜑2)
;   - ¬(𝜑1 ∨𝜑2) ⇒(¬𝜑1 ∧¬𝜑2)
;   - ¬(𝜑1 ∧𝜑2) ⇒(¬𝜑1 ∨¬𝜑2)
;   - (𝜑1 →(𝜑2 →𝜑3)) ⇒(𝜑1 ∧𝜑2) → 𝜑3
;   - ((𝜑1 →𝜑2) →𝜑2) ⇒(𝜑1 ∨𝜑2)
;   - (𝜑1 ∧(𝜑1 →𝜑2)) ⇒(𝜑1 ∧𝜑2)
;   - ((𝜑1 →𝜑2) ∧𝜑1) ⇒(𝜑1 ∧𝜑2)
(program $bool_simplify_small_step ((phi1 Bool) (phi2 Bool :list) (phi3 Bool :list))
  :signature (Bool) Bool
  (
   (
    ($bool_simplify_small_step (not (=> phi1 phi2)))

    (and phi1 (not phi2))
    )

   (
    ($bool_simplify_small_step (not (or phi1 phi2)))

    (and (not phi1) (not phi2))
    )

   (
    ($bool_simplify_small_step (not (and phi1 phi2)))

    (or (not phi1) (not phi2))
    )

   (
    ($bool_simplify_small_step (=> phi1 (=> phi2 phi3)))
    
    (=> (and phi1 phi2) phi3)
    )

   (
    ($bool_simplify_small_step (=> (=> phi1 phi2) phi2))

    (or phi1 phi2)
    )

   (
    ($bool_simplify_small_step (and (=> phi3 phi2) phi3))

    (and phi3 phi2)
    )

   (; { phi1 != (=> phi3 phi2) }
    ($bool_simplify_small_step (and phi1 phi2))

    ; Check which case we are into.
    (eo::ite ($is_implication phi2)

             (eo::define
              
              (
               (antecedent ($implication_get_antecedent phi2))

               (consequent ($implication_get_consequent phi2))
               )

              (eo::ite ($eo_is_eq phi1 antecedent)

                       ; Sixth case of bool_simplify.
                       (and phi1 consequent)

                       ; { not ($eo_is_eq phi1 antecedent) }
                       (and phi1 phi2)))

             ; { not ($is_implication phi2) }
             (and phi1 phi2))
    )

   (
    ($bool_simplify_small_step phi1)

    phi1
    )
  )
)

; program: $bool_simplify_rec
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying the equivalence-preserving transformations described
;   in `$bool_simplify_small_step` until a fixed point is reached.
(program $bool_simplify_rec ((operator (-> Bool Bool Bool)) (op Bool)
                             (ops Bool :list))
  :signature (Bool) Bool
  (
   (
    ($bool_simplify_rec (not op))

    (eo::define 

     ; We reduce top-to-bottom
     ((whole_exp_simplified ($bool_simplify_small_step (not op))))

     (eo::ite ($eo_is_eq whole_exp_simplified (not op))

              ; We continue reducing the sub-term
              (eo::define 

               ((op_simplified ($bool_simplify_rec op)))

               (eo::ite ($eo_is_eq op_simplified op)

                        ; We reached a fixed point.
                        (not op)

                                   
                         ; { not ($eo_is_eq op_simplified op) }
                         ($bool_simplify_rec (not op_simplified))))

              ; { not ($eo_is_eq whole_exp_simplified (not op)) }
              ($bool_simplify_rec whole_exp_simplified)))
    )

   (
    ($bool_simplify_rec (operator op ops))

    (eo::define 

     ; We reduce top-to-bottom
     ((whole_exp_simplified ($bool_simplify_small_step (operator op ops))))

     (eo::ite ($eo_is_eq whole_exp_simplified (operator op ops))

              ; We continue reducing, right-to-left.
              (eo::define 

               ((ops_simplified ($bool_simplify_rec ops)))

               (eo::ite ($eo_is_eq ops_simplified ops)

                        (eo::define 

                         ((op_simplified ($bool_simplify_rec op)))

                         (eo::ite ($eo_is_eq op_simplified
                                             op)

                                   ; We reached a fixed point.
                                   (operator op ops)

                                   
                                   ; { not ($eo_is_eq op_simplified op) }
                                   ($bool_simplify_rec (operator op_simplified 
                                                                 ops))))

                        ; { not ($eo_is_eq ops_simplified ops) }
                        ($bool_simplify_rec (operator op ops_simplified))))

              ; { not ($eo_is_eq whole_op_simplified 
              ;                  (operator op ops)) }
              ($bool_simplify_rec whole_exp_simplified)))
    )
   

   ( ; { op != operator ...}
     ($bool_simplify_rec op)

     op
     )
    )
  )

; program: $check_bool_simplify
; args:
; - lhs Bool: The left-hand side of the equality in the conclusion passed to rule  `bool_simplify`
; - rhs Bool: The right-hand side of the equality in the conclusion passed to rule `bool_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs` using 
;   `$bool_simplify_rec`.
(program $check_bool_simplify ((lhs Bool) (rhs Bool))
  :signature (Bool Bool) Bool
  (
   (
    ($check_bool_simplify lhs rhs)

    ($eo_is_eq ($bool_simplify_rec lhs)

               rhs)
    )
  )
)

; rule: bool_simplify
; requires: >
;   For `lhs` to be reducible to `rhs` following the rules 
;   in `$bool_simplify_rec`.
; conclusion-explicit: (@cl (= lhs rhs))
(declare-rule bool_simplify ((lhs Bool) (rhs Bool))
  :requires ((($check_bool_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 78: ac_simp
;-----------------------


; program: $idempotency_simp
; args:
; - formula Bool: An arbitrary boolean formula.
; return: >
;   The result from applying a single simplification step by idempotency of
;   conjunction or disjunctions. Required to properly implement the semantics
;   of ac_simp over formulas like (or a a), since $f_list_remove_duplicates
;   does not emulate that behavior.
(program $idempotency_simp ((hd Bool) (tl Bool :list) (formula Bool))
         :signature (Bool) Bool
         (
          (
           ($idempotency_simp (or hd tl))

           (eo::ite ($eo_is_eq ($f_list_length or tl) 2)

                    ; Nil-terminated list?
                    (eo::ite (eo::and ($eo_is_eq ($f_list_index or tl 0) hd)
                                      ($eo_is_eq ($f_list_index or tl 1) false))

                             hd

                             ; { not (eo::and ($eo_is_eq ($f_list_index or tl 0) hd)
                             ;                ($eo_is_eq ($f_list_index or tl 1) false)) }
                             (or hd tl))

                    ; { not ($eo_is_eq ($f_list_length or tl) 2) }
                    (eo::ite ($eo_is_eq ($f_list_length or tl) 1)

                             ; Non nil-terminated list?
                             (eo::ite ($eo_is_eq tl hd)

                                      hd

                                        ; { not ($eo_is_eq ($f_list_index or tl 0) hd) }
                                      (or hd tl))

                             ; {not ($eo_is_eq ($f_list_length and tl) 1) }
                             (or hd tl)))
           )

          (
           ($idempotency_simp (and hd tl))

           (eo::ite ($eo_is_eq ($f_list_length and tl) 2)

                    ; Nil-terminated list?
                    (eo::ite (eo::and ($eo_is_eq ($f_list_index and tl 0) hd)
                                      ($eo_is_eq ($f_list_index and tl 1) true))

                             hd

                             ; { not (eo::and ($eo_is_eq ($f_list_index and tl 0) hd)
                             ;                ($eo_is_eq ($f_list_index and tl 1) true)) }
                             (and hd tl))

                    ; { not ($eo_is_eq ($f_list_length and tl) 2) }
                    (eo::ite ($eo_is_eq ($f_list_length and tl) 1)

                             ; Non nil-terminated list?
                             (eo::ite ($eo_is_eq tl hd)

                                      hd

                                        ; { not ($eo_is_eq ($f_list_index and tl 0) hd) }
                                      (and hd tl))

                             ; {not ($eo_is_eq ($f_list_length and tl) 1) }
                             (and hd tl)))
           )

          (; { formula != or ..., and ... }
           ($idempotency_simp formula)

           formula
           )
          )
         )

; define: $ac_simp_step
; args:
; - op (-> Bool Bool Bool): Logical connective to be considered for the ac step.
; - nil Bool: Neutral element of `op`.
; - formula Bool: Boolean formula upon which the ac step should be performed.
; return: >
;   A formula obtained from removing duplicates and flattening applications of
;   `op`, within `formula`.
(define $ac_simp_step ((op (-> Bool Bool Bool)) (formula Bool))
        ($f_list_remove_duplicates op ($idempotency_simp ($flat_and_or op formula))))

; program: $ac_simp_rec
; args:
; - lhs Bool: >
;   left-hand side term present in the conclusion passed to `ac_simp`
; return: >
;   A flattened version of `lhs`, using `$ac_simp_step` at different nesting
;   levels, and for every occurrence of `and` and `or`.
(program $ac_simp_rec ((formula Bool) (tail Bool :list))

  :signature (Bool) Bool

  (
   (
    ($ac_simp_rec (and formula tail))

    (eo::define
     
     (
      (formula_ac_simp ($ac_simp_rec formula))

      (tail_ac_simp ($ac_simp_rec tail))
      )

     ($ac_simp_step and 
                    ($to_nil_terminated_f_list and true
                                               ($f_list_cons and formula_ac_simp tail_ac_simp))))
    )

   (
    ($ac_simp_rec (or formula tail))

    (eo::define
     
     (
      (formula_ac_simp ($ac_simp_rec formula))

      (tail_ac_simp ($ac_simp_rec tail))
      )

     ($ac_simp_step or 
                    ($to_nil_terminated_f_list or false
                                               ($f_list_cons or formula_ac_simp tail_ac_simp))
                    ))
    )

   (; { formula != or ..., and ... }
    ($ac_simp_rec formula)

    formula
    )
   )
  )

; program: $check_ac_simp
; args:
; - lhs Bool: >
;   left-hand side term present in the conclusion passed to `ac_simp`
; - rhs Bool: >
;   right-hand side term present in the conclusion passed to `ac_simp`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs`, using the rules
;   in `$ac_simp_rec`.
(program $check_ac_simp ((formula Bool) (tail Bool :list) (rhs Bool))

  :signature (Bool Bool) Bool

  (
   (
    ($check_ac_simp (and formula tail) rhs)

     ($f_list_equal_mod_commut_and_length 
      and 
      ($ac_simp_rec (and formula tail)) rhs)
    )
   
   (
    ($check_ac_simp (or formula tail) rhs)

     ($f_list_equal_mod_commut_and_length 
      or
      ($ac_simp_rec (or formula tail)) rhs)
    )
   )
  )

; rule: ac_simp
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  associativity to the left, exploiting idempotency to remove duplicated
;  elements and modulo commutativity.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule ac_simp ((lhs Bool) (rhs Bool))
  :requires ((($check_ac_simp lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)


;-----------------------
; Rule 79: ite_simplify
;-----------------------

; program: $ite_simplify_small_step
; args:
; - formula Bool: A boolean formula.
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations, to `formula`:
;   - (ite ⊤ 𝑡1 𝑡2) ⇒ 𝑡1
;   - (ite ⊥ 𝑡1 𝑡2) ⇒ 𝑡2
;   - (ite 𝜓 𝑡 𝑡) ⇒ 𝑡
;   - (ite ¬𝜑 𝑡1 𝑡2) ⇒ (ite 𝜑 𝑡2 𝑡1)
;   - (ite 𝜓 (ite 𝜓 𝑡1 𝑡2) 𝑡3) ⇒ (ite 𝜓 𝑡1 𝑡3)
;   - (ite 𝜓 𝑡1 (ite 𝜓 𝑡2 𝑡3) ⇒ (ite 𝜓 𝑡1 𝑡3)
;   - (ite 𝜓⊤⊥) ⇒ 𝜓
;   - (ite 𝜓⊥⊤) ⇒ ¬𝜓
;   - (ite 𝜓 ⊤ 𝜑) ⇒ 𝜓 ∨ 𝜑
;   - (ite 𝜓 𝜑 ⊥) ⇒ 𝜓 ∧ 𝜑
;   - (ite 𝜓 ⊥ 𝜑) ⇒ ¬ 𝜓 ∧ 𝜑
;   - (ite 𝜓 𝜑 ⊤) ⇒ ¬ 𝜓 ∨ 𝜑
(program $ite_simplify_small_step ((t1 Bool) (t2 Bool) (t3 Bool) (psi Bool) (phi Bool))

         :signature (Bool) Bool

         (
          (
           ($ite_simplify_small_step (ite true t1 t2))

           t1
           )

          (
           ($ite_simplify_small_step (ite false t1 t2))

           t2
           )

          (
           ($ite_simplify_small_step (ite psi t1 t1))

           t1
           )

          (
           ($ite_simplify_small_step (ite (not psi) t1 t2))

           (ite psi t2 t1)
           )

          (
           ($ite_simplify_small_step (ite psi (ite psi t1 t2) t3))

           (ite psi t1 t3)
           )

          (
           ($ite_simplify_small_step (ite psi t1 (ite psi t2 t3)))

           (ite psi t1 t3)
           )

          (
           ($ite_simplify_small_step (ite psi true false))

           psi
           )

          (
           ($ite_simplify_small_step (ite psi false true))

           (not psi)
           )

          (
           ($ite_simplify_small_step (ite psi true phi))

           (or psi phi)
           )

          (
           ($ite_simplify_small_step (ite psi phi false))

           (and psi phi)
           )

          (
           ($ite_simplify_small_step (ite psi false phi))

           (and (not psi) phi)
           )

          (
           ($ite_simplify_small_step (ite psi phi true))

           (or (not psi) phi)
           )

          (; { psi is not an ite construction }
           ($ite_simplify_small_step psi)
           
           psi
           )
          )
         )

; program: $ite_simplify_rec
; args:
; - formula A: A boolean formula.
; return: >
;   The result from applying the equivalence-preserving transformations described
;   in `$ite_simplify_small_step`, until a fixed point is reached.
(program $ite_simplify_rec ((ite_term Bool))

  :signature (Bool) Bool

  (
   (
    ($ite_simplify_rec ite_term)

    (eo::define 

     (
      (ite_term_reduced ($ite_simplify_small_step ite_term))
      )

     (eo::ite ($eo_is_eq ite_term_reduced ite_term)

              ite_term

              ; { not ($eo_is_eq item_term_reduced ite_term) }
              ($ite_simplify_rec ite_term_reduced)))
    )

   ( 
    ($ite_simplify_rec ite_term)

    ite_term
    )
   )
  )

; program: $check_ite_simplify
; args:
; - lhs Bool: >
;   left-hand side term present in the conclusion passed to `ite_simplify`
; - rhs Bool: >
;   right-hand side term present in the conclusion passed to `ite_simplify`
; return: >
;   A boolean indicating if `div` can be reduced to `term`, using the rules
;   in `$ite_simplify_rec`.
(program $check_ite_simplify ((lhs Bool) (rhs Bool))

  :signature (Bool Bool) Bool

  (
   (
    ($check_ite_simplify lhs rhs)

    ($eo_is_eq ($ite_simplify_rec lhs) rhs)
    )
   )
  )

; rule: ite_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$ite_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule ite_simplify ((lhs Bool) (rhs Bool))
  :requires ((($check_ite_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 80: qnt_simplify
;-----------------------

; program: $check_qnt_simplify
; args:
; - formula Bool: >
;   The body of the quantification present in the conclusion passed to rule
;   qnt_simplify.
; return: >
;   A boolean indicating if `formula` is equal to true or false.
(program $check_qnt_simplify ((formula Bool))
         
         :signature (Bool) Bool

         (
          (
           ($check_qnt_simplify true)

           true
           )

          (
           ($check_qnt_simplify false)

           true
           )

          (; { formula != true, false }
           ($check_qnt_simplify formula)

           false
           )
          )
         )

; rule: qnt_simplify
; requires: >
;   For a given conclusion of the form (@cl (= (forall varlist phi) phi)), phi
;   must be "true" or "false".
; conclusion-explicit: >
;   The conclusion should be of the form (@cl (= (forall varlist phi) phi)).
(declare-rule qnt_simplify ((phi Bool) (varlist @VarList))
  :requires ((($check_qnt_simplify phi) true))
  :conclusion-explicit (@cl (= (forall varlist phi) phi))
)


;-----------------------
; Rule 83: qnt_rm_unused
;-----------------------

; program: $check_free_variables
; args:
; - varlist1 VarList: Original list of quantified variables.
; - varlist2 VarList: >
;   List of quantified variables where unused variables where removed
; - free_variables VarList: >
;   List of free variables in the body of the original quantified formula.
; return: >
;   A boolean indicating if every variable in `varlist1` that is not 
;   present in `varlist2` does not in `free_variables` (i.e., does not 
;   appear free in the body of the original quantified formula).
(program $check_free_variables ((varlist1 @VarList) (varlist2 @VarList)
                                (free_variables @VarList)
                                (A Type) (var A) (tail A :list))

         :signature (@VarList @VarList @VarList) Bool

         (
          (
           ($check_free_variables @varlist.nil varlist2 free_variables)
           
           true
           )

          (
           ($check_free_variables (@varlist var tail) varlist2 free_variables)
           
           (eo::ite (eo::not ($f_list_contains_elem @varlist var varlist2))

                    (eo::and (eo::not ($f_list_contains_elem @varlist var free_variables))

                             ($check_free_variables tail varlist2 free_variables))

                    ; { (f_list_contains_elem @varlist var varlist2) }
                    ($check_free_variables tail varlist2 free_variables))
           )
          )
         )


; program: $check_qnt_rm_unused
; args:
; - conclusion Bool: Conclusion given to rule `qnt_rm_unused`.
; return: >
;   A boolean indicating if `conclusion` has the form:
;   𝑄𝑥1, … , 𝑥𝑛. 𝜑 ≈ 𝑄 𝑥𝑘1, … , 𝑥𝑘𝑚. 𝜑
;   Where the list of variables 𝑥𝑘1, … , 𝑥𝑘𝑚 is obtained from the original list
;   𝑥1, … , 𝑥n, by removing variables that are already bound in 𝜑.
(program $check_qnt_rm_unused ((varlist_1 @VarList) (varlist_2 @VarList) (phi Bool))
  :signature (Bool) Bool
  (
   (
    ($check_qnt_rm_unused (@cl (= (forall varlist_1 phi) (forall varlist_2 phi))))

    
    (eo::and ; varlist_2 is contained in varlist_1
             ($f_list_contains_f_list @varlist varlist_2 varlist_1)
             
             ($check_free_variables varlist_1 varlist_2 ($fv phi)))
    )

   (
    ($check_qnt_rm_unused (@cl (= (exists varlist_1 phi) (exists varlist_2 phi))))

    
    (eo::and ; varlist_2 is contained in varlist_1
             ($f_list_contains_f_list @varlist varlist_2 varlist_1)
             
             ($check_free_variables varlist_1 varlist_2 ($fv phi)))
    )
  )
)

; rule: qnt_rm_unused
; requires: >
;   For the conclusion to be of the form:
;   𝑄𝑥1, … , 𝑥𝑛. 𝜑 ≈ 𝑄 𝑥𝑘1, … , 𝑥𝑘𝑚. 𝜑
;   Where the list of variables 𝑥𝑘1, … , 𝑥𝑘𝑚 is obtained from the original list
;   𝑥1, … , 𝑥n, by removing variables that are already bound in 𝜑.
; conclusion-explicit: A conclusion of the form (@cl (= lhs rhs)).
(declare-rule qnt_rm_unused ((lhs Bool) (rhs Bool))
  :requires ((($check_qnt_rm_unused (@cl (= lhs rhs))) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 84: eq_simplify
;-----------------------

; program: $eq_simplify_small_step
; args:
; - exp A: An arith expression.
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations, to `exp`:
;   - 𝑡 ≈ 𝑡 ⇒ ⊤
;   - (𝑡1 ≈ 𝑡2) ⇒ ⊥ if 𝑡1 and 𝑡2 are different numeric constants.
;   - ¬(𝑡 ≈ 𝑡) ⇒ ⊥ if 𝑡 is a numeric constant
(program $eq_simplify_small_step ((A Type) (t1 A) (t2 A) (eq Bool))

         :signature (Bool) Bool

         (
          (
           ($eq_simplify_small_step (= t1 t1))

           true
           )

          (; { t1 != t2 }
           ($eq_simplify_small_step (= t1 t2))

           (eo::ite (eo::and ($is_numeric_literal t1)
                             ($is_numeric_literal t2))
                    
                    false

                    (= t1 t2))
           )

          (
           ($eq_simplify_small_step (not (= t1 t1)))

           (eo::ite ($is_numeric_literal t1)
                    
                    false

                    (not (= t1 t1)))
           )

          (
           ($eq_simplify_small_step eq)
           
           eq
           )
          )
         )

; program: $check_eq_simplify
; args:
; - lhs Bool: >
;   left-hand side term present in the conclusion passed to `eq_simplify`
; - rhs Bool: >
;   right-hand side term present in the conclusion passed to `eq_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs`, using the rules
;   in `$eq_simplify_small_step`.
(program $check_eq_simplify ((lhs Bool) (rhs Bool))
  :signature (Bool Bool) Bool
  (
   (
    ($check_eq_simplify lhs rhs)

    ($eo_is_eq ($eq_simplify_small_step lhs) rhs)
    )
   )
  )

; rule: eq_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$eq_simplify_small_step`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule eq_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_eq_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 85: div_simplify
;-----------------------

; program: $div_simplify_small_step
; args:
; - exp A: An arith expression.
; return: >
;   The result from applying one of the following value-preserving 
;   transformations, to `exp`:
;   - 𝑡/𝑡 ⇒ 1
;   - 𝑡/1 ⇒ 𝑡
;   - 𝑡1/𝑡2 ⇒ 𝑡3, if 𝑡1 and 𝑡2 are constants and 𝑡3 is 𝑡1 divided by 𝑡2 according 
;     to the semantics of the current theory.
(program $div_simplify_small_step ((A Type) (t1 A) (t2 A))
         :signature (A) A
         (
          (
           ($div_simplify_small_step (/ t1 t1))

           (eo::ite ($eo_is_eq (eo::typeof t1) Int)

                    1
                    
                    ; { not ($eo_is_eq (eo::typeof t1) Int) }
                    1/1)
           )

          (
           ($div_simplify_small_step (/ t1 1))

           t1
           )

          (
           ($div_simplify_small_step (/ t1 1/1))

           t1
           )

          (
           ($div_simplify_small_step (/ t1 t2))

           (eo::ite (eo::and ($is_numeric_literal t1)
                             ($is_numeric_literal t2))

                    (eo::ite ($eo_is_eq (eo::typeof t1) Int)

                             (eo::zdiv t1 t2)
                             
                             ; { not ($eo_is_eq (eo::typeof t1) Int) }
                             (eo::qdiv t1 t2))

                    ; { not (eo::and ($is_numeric_literal t1)
                    ;                ($is_numeric_literal t2)) }
                    (/ t1 t2)
                    )
           )

          (; { t1 is not a division }
           ($div_simplify_small_step t1)
           
           t1
          )
         )
         )

; program: $div_simplify_rec
; args:
; - term A: An arithmetic term.
; return: >
;   The result from applying the value-preserving transformations described
;   in `$div_simplify_small_step`, until a fixed point is reached.
(program $div_simplify_rec ((A Type) (num A) (den A) (term A))

  :signature (A) A

  (
   (
    ($div_simplify_rec (/ num den))

    (eo::define 

     (
      (num_reduced ($div_simplify_small_step num))
      )

     (eo::ite ($eo_is_eq num_reduced num)

              (eo::define 

               (
                (den_reduced ($div_simplify_small_step den))
                )

               (eo::ite ($eo_is_eq den_reduced den)

                        (eo::define 

                         (
                          (div_reduced ($div_simplify_small_step 
                                        (/ num_reduced den_reduced)))
                          )

                         (eo::ite ($eo_is_eq div_reduced (/ num_reduced den_reduced))

                                  div_reduced
                                  
                                  ; {not ($eo_is_eq div_reduced (/ num_reduced den_reduced))}
                                  ($div_simplify_rec div_reduced)))

                        ; { not ($eo_is_eq den_reduced den) }
                        ($div_simplify_rec (/ num_reduced den_reduced))))
              
              ; { not ($eo_is_eq num_reduced num) }
              ($div_simplify_rec (/ num_reduced den))))
    )

   ( 
    ($div_simplify_rec term)

    term
    )
   )
  )

; program: $check_div_simplify
; args:
; - div A: >
;   left-hand side term present in the conclusion passed to `div_simplify`
; - term A: >
;   right-hand side term present in the conclusion passed to `div_simplify`
; return: >
;   A boolean indicating if `div` can be reduced to `term`, using the rules
;   in `$div_simplify_rec`.
(program $check_div_simplify ((A Type) (num A) (den A) (term A))

  :signature (A A) Bool

  (
   (
    ($check_div_simplify (/ num den) term)

    ($eo_is_eq ($div_simplify_rec (/ num den)) term)
    )
   )
  )

; rule: div_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$div_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule div_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_div_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)


;-----------------------
; Rule 86: prod_simplify
;-----------------------

; program: $check_prod_simplify
; args:
; - lhs A: Left-hand side in the conclusion provided to `prod_simplify`. 
; - rhs A: Right-hand side in the conclusion provided to `prod_simplify`. 
; return: >
;   A boolean indicating if `lhs` and `rhs` evaluates to the same value, by 
;   virtue of just reordering factors and evaluating products, when possible.
(program $check_prod_simplify ((A Type) (lhs A) (rhs A))
  :signature (A A) Bool
  (
   (
    ($check_prod_simplify lhs rhs) 
    
    (eo::define
     (; Only reorder and evaluation of the terms is allowed.
      (lhs_evaluated ($small_step_evaluator_arith_term 
                      ($assoc_evaluatable_terms
                       ($reorder_arith_term lhs))))

      ; We fully evaluate `rhs`, so it can be easily compared with `lhs`.
      (rhs_evaluated ($evaluate_arith_term rhs))
      )

     (eo::ite (eo::and ($is_evaluatable lhs_evaluated)
                       ($is_evaluatable rhs_evaluated))

              ($eo_is_eq (eo::to_q lhs_evaluated) (eo::to_q rhs_evaluated))
              
              ; { not (eo::and ($is_evaluatable lhs_evaluated)
              ;       ($is_evaluatable rhs_evaluated)) }
              ($eo_is_eq lhs_evaluated rhs_evaluated)
              )
     )
    )
   )
)

; rule: prod_simplify
; requires: > 
;   For the left-hand side of the conclusion to be reduced to the same value
;   as the right-hand side, only by virtue of reordering factors and evaluating
;   products. 
; conclusion: Conclusion must be of the form 𝑡1 × ⋯× 𝑡𝑛 ≈ 𝑢.
(declare-rule prod_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_prod_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;------------------------------
; Rule 87: unary_minus_simplify
;------------------------------

; program: $check_unary_minus_simplify
; args:
; - lhs A: >
;   left-hand side term present in the conclusion passed to `unary_minus_simplify`
; - rhs A: >
;   right-hand side term present in the conclusion passed to `unary_minus_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs`, applying, either,
;   double negation or evaluating the negation, over `lhs`.
(program $check_unary_minus_simplify ((A Type) (t A) (u A))
  :signature (A A) Bool
  (
   (
    ($check_unary_minus_simplify (- (- t)) t)

    true
    )

   (
    ($check_unary_minus_simplify (- t) u)

    (eo::ite (eo::and ($is_numeric_literal t)
                      ($is_numeric_literal u))

             (eo::ite ($eo_is_eq u (eo::neg t))

                      true
                      ; { not ($eo_is_eq u (eo::neg t)) }
                      false)

             ; { not (eo::and ($is_numeric_literal t)
             ;                ($is_numeric_literal u)) }
             false)
                      
    )
   )
  )

; rule: unary_minus_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$unary_minus_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule unary_minus_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_unary_minus_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 88: minus_simplify
;-----------------------

; program: $minus_simplify_small_step
; args:
; - term A: An arithmetic term.
; return: >
;   The result from applying one of the following value-preserving 
;   transformations, to `term`:
;   - 𝑡 − 𝑡 ⇒ 0
;   - 𝑡1 − 𝑡2 ⇒ 𝑡3, where 𝑡1 and 𝑡2 are numerical constants and 𝑡3 is 𝑡2 subtracted 
;     from 𝑡1.
;   - 𝑡 − 0 ⇒ 𝑡
;   - 0 − 𝑡 ⇒ − 𝑡
(program $minus_simplify_small_step ((A Type) (t1 A) (t2 A))

         :signature (A) A

         (
          (
           ($minus_simplify_small_step (- t1 t1))

           (eo::ite ($eo_is_eq (eo::typeof t1) Int)

                    0
                    
                    ; { not ($eo_is_eq (eo::typeof t1) Int) }
                    0/1)
           )

          (
           ($minus_simplify_small_step (- t1 0))

           t1
           )

          (
           ($minus_simplify_small_step (- t1 0/1))

           t1
           )

          (
           ($minus_simplify_small_step (- 0 t1))

           (- t1)
           )

          (
           ($minus_simplify_small_step (- 0/1 t1))

           (- t1)
           )

          (
           ($minus_simplify_small_step (- t1 t2))

           (eo::ite (eo::and ($is_numeric_literal t1)
                             ($is_numeric_literal t2))

                    (eo::add t1 (eo::neg t2))

                    ; { not (eo::and ($is_numeric_literal t1)
                    ;                ($is_numeric_literal t2)) }
                    (- t1 t2))
           )

          (
           ($minus_simplify_small_step t1)

           t1
           )
          )
         )

; program: $minus_simplify_rec
; args:
; - term A: An arithmetic term.
; return: >
;   The result from applying the value-preserving transformations described
;   in `$minus_simplify_small_step`, until a fixed point is reached.
(program $minus_simplify_rec ((A Type) (minus_term A))

  :signature (A) A

  (
   (
    ($minus_simplify_rec minus_term)

    (eo::define 

     (
      (minus_term_reduced ($minus_simplify_small_step minus_term))
      )

     (eo::ite ($eo_is_eq minus_term_reduced minus_term)

              minus_term

              ; { not ($eo_is_eq item_term_reduced minus_term) }
              ($minus_simplify_rec minus_term_reduced)))
    )

   ( 
    ($minus_simplify_rec minus_term)

    minus_term
    )
   )
  )

; program: $check_minus_simplify
; args:
; - lhs A: >
;   left-hand side term present in the conclusion passed to `minus_simplify`
; - rhs A: >
;   right-hand side term present in the conclusion passed to `minus_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs`, using the rules
;   in `$minus_simplify_rec`.
(program $check_minus_simplify ((A Type) (lhs A) (rhs A))
  :signature (A A) Bool
  (
   (
    ($check_minus_simplify lhs rhs)

    ($eo_is_eq ($minus_simplify_rec lhs) rhs)
    )
   )
  )

; rule: minus_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$minus_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule minus_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_minus_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)

;-----------------------
; Rule 88: sum_simplify
;-----------------------

; program: $check_sum_simplify
; args:
; - lhs A: >
;   left-hand side term present in the conclusion passed to `sum_simplify`
; - rhs A: >
;   right-hand side term present in the conclusion passed to `sum_simplify`
; return: >
;   A boolean indicating if `lhs` can be reduced to `rhs`, using only
;   reordering of terms and evaluation.
(program $check_sum_simplify ((A Type) (lhs A) (rhs A))
  :signature (A A) Bool
  (
   (
    ($check_sum_simplify lhs rhs)

    ($eo_is_eq ($small_step_evaluator_arith_term
                ($assoc_evaluatable_terms 
                 ($reorder_arith_term lhs)))

               rhs)
    )
   )
  )

; rule: sum_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$sum_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule sum_simplify ((A Type) (lhs A) (rhs A))
  :requires ((($check_sum_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)


;-----------------------
; Rule 90: comp_simplify
;-----------------------

; program: $comp_simplify_small_step
; args:
; - formula Bool: A formula of the form 𝑡1 ⋈ 𝑡2, where ⋈ ∈ {<, >, ≤, ≥}
; return: >
;   The result from applying one of the following equivalence-preserving 
;   transformations:
;   - 𝑠1 < 𝑠2 ⇒⊤ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is strictly less than 𝑠2
;   - 𝑠1 < 𝑠2 ⇒⊥ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is greater or equal than 𝑠2
;   - 𝑠1 ≤ 𝑠2 ⇒⊤ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is less or equal than 𝑠2
;   - 𝑠1 ≤ 𝑠2 ⇒⊥ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is strictly greater than 𝑠2
;   - 𝑠 < 𝑠 ⇒ ⊥
;   - 𝑠 ≤ 𝑠 ⇒ ⊤
;   - 𝑠1 ≥ 𝑠2 ⇒ 𝑠2 ≤ 𝑠1
;   - 𝑠1 < 𝑠2 ⇒ ¬(𝑠2 ≤ 𝑠1)
;   - 𝑠1 > 𝑠2 ⇒ ¬(𝑠1 ≤ 𝑠2)
(program $comp_simplify_small_step ((A Type) (t1 A) (t2 A))
         :signature (Bool) Bool
         (
          (
           ($comp_simplify_small_step (< t1 t1))

           false
           )

          (
           ($comp_simplify_small_step (<= t1 t1))

           true
           )

          (
           ($comp_simplify_small_step (>= t1 t2))

           (<= t2 t1)
           )

          (
           ($comp_simplify_small_step (> t1 t2))

           (not (<= t1 t2))
           )

          (; { t1 != t2 }
           ($comp_simplify_small_step (<= t1 t2))

           (eo::ite (eo::and ($is_numeric_literal t1)
                             ($is_numeric_literal t2))

                    (eo::not (eo::gt t1 t2))

                    ; { not (eo::and ($is_numeric_literal t1)
                    ;                ($is_numeric_literal t2))}
                    (<= t1 t2)
                    )
           )

          (; { t1 != t2 }
           ($comp_simplify_small_step (< t1 t2))

           (eo::ite (eo::and ($is_numeric_literal t1)
                             ($is_numeric_literal t2))

                    (eo::gt t2 t1)

                    ; { not (eo::and ($is_numeric_literal t1)
                    ;                ($is_numeric_literal t2))}
                    (not (<= t2 t1))
                    )
           )
          )
         )

; program: $comp_simplify_rec
; args:
; - formula Bool: A formula.
; return: >
;   The result from applying the equivalence-preserving transformations described
;   in `$comp_simplify_small_step`, until a fixed point is reached.
(program $comp_simplify_rec ((ineq Bool) (A Type) (order (-> A A Bool)) 
                             (lhs A) (rhs A))
  :signature (Bool) Bool
  (
   (
    ($comp_simplify_rec (order lhs rhs))

    (eo::define 

     ((order_reduced ($comp_simplify_small_step (order lhs rhs))))

     (eo::ite ($eo_is_eq order_reduced (order lhs rhs))

              order_reduced

              ; { not ($eo_is_eq order_reduced (order lhs rhs)) }
              ($comp_simplify_rec order_reduced)))
    )

   ( ; { ineq != order ...}
     ($comp_simplify_rec ineq)

     ineq
     )
    )
  )

; program: $check_comp_simplify
; args:
; - ineq Bool: >
;   left-hand side inequality present in the conclusion passed to `comp_simplify`
; - psi Bool: >
;   right-hand side inequality present in the conclusion passed to `comp_simplify`
; return: >
;   A boolean indicating if `ineq` can be reduced to `psi`, using the rules
;   in `$comp_simplify_rec`.
(program $check_comp_simplify ((A Type) (lhs A) (rhs A) (psi Bool)
                               (order (-> A A Bool)))
  :signature (Bool Bool) Bool
  (
   (
    ($check_comp_simplify (order lhs rhs) psi) 

    ($eo_is_eq ($comp_simplify_rec (order lhs rhs)) psi)
    )
   )
  )

; rule: comp_simplify
; requires: >
;  For `rhs` in conclusion to be the canonical form of `lhs`, according to
;  rules in `$comp_simplify_rec`.
; conclusion-explicit: Conclusion of the form (@cl (= lhs rhs)),
(declare-rule comp_simplify ((lhs Bool) (rhs Bool))
  :requires ((($check_comp_simplify lhs rhs) true))
  :conclusion-explicit (@cl (= lhs rhs))
)


;-----------------------
; Rule 103: eq_symmetric
;-----------------------

; rule: eq_symmetric
; conclusion-explicit: >
;   Conclusion must have the form (@cl (= (= t1 t2) (= t2 t1))), for terms 
;   t1 and t2 of arbitrary type.
(declare-rule eq_symmetric ((A Type) (B Type) (t1 A) (t2 B))
  :conclusion-explicit (@cl (= (= t1 t2) (= t2 t1)))
)

;---------------
; Rule tautology
;---------------

(program $remove_leading_negations_in_clause ((hd Bool) (tl Bool :list))
  :signature (Bool) Bool
  (
   (
    ($remove_leading_negations_in_clause (@cl hd tl))

    ($f_list_cons @cl 
                  ($remove_leading_negations hd)
                  ($remove_leading_negations_in_clause tl))
    )

   (
    ($remove_leading_negations_in_clause hd)

    ($remove_leading_negations hd)
    )
  )
)

(program $check_tautology_in_normalized_clause ((hd Bool) (tl Bool :list))
         :signature (Bool) Bool
         (
          (
           ($check_tautology_in_normalized_clause (@cl (not hd) tl))

           (eo::or ($f_list_contains_elem @cl hd tl)
                   ($check_tautology_in_normalized_clause tl))
           )

          (; { hd != not ... }
           ($check_tautology_in_normalized_clause (@cl hd tl))

           (eo::or ($f_list_contains_elem @cl (not hd) tl)
                   ($check_tautology_in_normalized_clause tl))
           )

          (
           ($check_tautology_in_normalized_clause false)

           false
           )
          )
         )

(program $check_tautology ((premise Bool))
         :signature (Bool Bool) Bool
         (
          (
           ($check_tautology premise (@cl true))

           ($check_tautology_in_normalized_clause
            ($remove_leading_negations_in_clause premise))
           )
          )
         )

(declare-rule tautology ((premise Bool))
  :premises (premise)
  :requires ((($check_tautology premise (@cl true)) true))
  :conclusion (@cl true)
)
